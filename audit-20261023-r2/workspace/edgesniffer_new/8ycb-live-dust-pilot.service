[Unit]
Description=8YCB isolated one-trade live dust pilot (disabled by default)
After=network-online.target
Wants=network-online.target
Conflicts=8ycb-sniper.service

[Service]
Type=simple
User=sniper8ycb
Group=sniper8ycb
WorkingDirectory=/var/lib/8ycb-live-dust-pilot
EnvironmentFile=/etc/8ycb-sniper/8ycb-sniper.env
EnvironmentFile=/etc/8ycb-sniper/provider.env
EnvironmentFile=/etc/8ycb-sniper/wallet.env
EnvironmentFile=/etc/8ycb-live-dust-pilot/pilot.env
UnsetEnvironment=FAST_SOURCE_SOCKET_PATH
ExecStartPre=/usr/local/lib/8ycb-live-dust-pilot/preflight.sh
ExecStart=/usr/bin/flock -n /run/8ycb-live-dust-pilot.lock /usr/local/lib/8ycb-live-dust-pilot/supervisor.sh
ExecStopPost=+/usr/local/lib/8ycb-live-dust-pilot/disarm-if-consumed.sh
Restart=no
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/usr/local/lib/8ycb-sniper /etc/8ycb-sniper/8ycb-sniper.env /etc/8ycb-sniper/provider.env /etc/8ycb-sniper/wallet.env /etc/8ycb-live-dust-pilot/pilot.env /etc/8ycb-live-dust-pilot/ARMED /etc/8ycb-execution-gate
ReadWritePaths=/var/lib/8ycb-live-dust-pilot /var/log/8ycb-live-dust-pilot /run/8ycb-live-dust-pilot.lock
InaccessiblePaths=/var/lib/8ycb-sniper /var/log/8ycb-sniper /var/lib/8ycb-prospective-shadow-v5-netcup /var/log/8ycb-prospective-shadow-v5-netcup /var/lib/8ycb-canonical /var/log/8ycb-canonical /mnt/HC_Volume_106775198/edgesniffer-derived/8ycb-prospective-shadow-v4 /mnt/HC_Volume_106775198/edgesniffer-derived/8ycb-prospective-shadow-v5-netcup /run/8ycb-prospective-shadow-v5-netcup.lock /run/edgesniffer-2cq-symmetric-choice-v2.lock

[Install]
# Intentionally disabled. Arming is a separate root-controlled action.
WantedBy=multi-user.target
