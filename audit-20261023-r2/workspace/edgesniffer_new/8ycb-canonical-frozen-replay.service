[Unit]
Description=8YCB canonical frozen economic replay worker
After=8ycb-canonical-pump-tape.service 8ycb-canonical-economic-gate.service
Requires=8ycb-canonical-pump-tape.service 8ycb-canonical-economic-gate.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/lib/8ycb-canonical/frozen_replay.py
Restart=always
RestartSec=3
Environment=NO_SUBMIT_HARD_GUARD=8YCB_OBSERVATION_ONLY_V3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/var/lib/8ycb-canonical/launch-identity-ledger.jsonl
ReadOnlyPaths=/var/lib/8ycb-canonical/pump-tape/evidence.jsonl
ReadOnlyPaths=/mnt/HC_Volume_106775198/edgesniffer-derived/8ycb-prospective-shadow-v4/frozen_spec.json
ReadOnlyPaths=/mnt/HC_Volume_106775198/edgesniffer-derived/8ycb-prospective-shadow-v4/v3_recurrent_wallets.json
ReadWritePaths=/var/lib/8ycb-canonical/economics
UMask=0077

[Install]
WantedBy=multi-user.target
