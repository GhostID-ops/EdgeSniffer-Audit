[Unit]
Description=EdgeSniffer 2CQ V3 dual-live canonical source plane
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/EdgeSniffer/rust-exact-ledger
EnvironmentFile=/root/bot/EdgeSniffer/.env
EnvironmentFile=-/etc/edgesniffer-2cq-v3.env
Environment=YELLOWSTONE_FULL_META_ENDPOINT=https://grpc.va.shyft.to/
ExecStart=/root/bot/EdgeSniffer/rust-exact-ledger/target/release/yellowstone_v3_dual_observer
Restart=on-failure
RestartSec=3
CPUWeight=300
IOWeight=300
MemoryMax=2G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1
UMask=0027
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
