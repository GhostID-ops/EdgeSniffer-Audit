[Unit]
Description=EdgeSniffer 2CQ native receipt/finalized wallet join (receive-only research)
After=edgesniffer-2cq-finalized-wallet-source-v1.service edgesniffer-2cq-new-wallet-native-shredstream-receipts-v3.service
Wants=edgesniffer-2cq-finalized-wallet-source-v1.service edgesniffer-2cq-new-wallet-native-shredstream-receipts-v3.service

[Service]
Type=simple
WorkingDirectory=/root/bot/EdgeSniffer
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/joinNativeReceiptsToFinalizedWalletV1.py --finalized /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/2cq-finalized-wallet-source-v1.jsonl --receipts /mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v9/native-shredstream-route-candidate-receipts-v3 --output /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/2cq-native-finalized-wallet-joins-v1.jsonl --state /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/2cq-native-finalized-wallet-joins-v1.state.json --poll-ms 1000
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1

[Install]
WantedBy=multi-user.target
