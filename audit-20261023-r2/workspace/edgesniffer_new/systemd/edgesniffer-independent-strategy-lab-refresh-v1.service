[Unit]
Description=EdgeSniffer independent strategy lab refresh (read-only research)
After=edgesniffer-independent-pump-state-bridge-v1.service
Wants=edgesniffer-independent-pump-state-bridge-v1.service

[Service]
Type=simple
WorkingDirectory=/root/bot/EdgeSniffer/scripts
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/refreshIndependentStrategyLabV1.py --input /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/native-pump-state-enriched.jsonl --windows /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/independent-market-windows-v1.jsonl --report /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/independent-strategy-report-v1.json --poll-sec 60
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1

[Install]
WantedBy=multi-user.target
