[Unit]
Description=EdgeSniffer LaunchLab finalized evidence reconciler V1 (research only)
After=network-online.target edgesniffer-allenhark-compact-delivery-observer-v1.service
Wants=network-online.target
OnSuccess=edgesniffer-2cq-route-symmetric-choice-v1.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer/scripts
RuntimeDirectory=edgesniffer-launchlab-v1
ExecStart=/usr/bin/flock -n /run/edgesniffer-launchlab-v1/reconcile.lock /usr/bin/python3 /root/bot/EdgeSniffer/scripts/launchLabEvidenceReconcilerV1.py --arrivals /mnt/HC_Volume_106775198/edgesniffer-research/2cq-launchlab-coverage-v1/arrivals.jsonl --compact-arrivals /mnt/HC_Volume_106775198/edgesniffer-research/2cq-realtime-delivery-path-localization-v1/allenhark-signature-arrivals-v1.bin --env /root/bot/EdgeSniffer/.env --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-launchlab-coverage-v1 --seed-pools /mnt/HC_Volume_106775198/edgesniffer-research/2cq-launchlab-coverage-v1/teacher-known-pools.txt --limit 3000
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/root/bot/EdgeSniffer/.env
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-launchlab-coverage-v1
TimeoutStartSec=15min
MemoryHigh=2G
MemoryMax=3G
