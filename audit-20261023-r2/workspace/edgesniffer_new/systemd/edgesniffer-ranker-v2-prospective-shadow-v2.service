[Unit]
Description=EdgeSniffer Ranker V2 canonical event-gated prospective no-submit shadow v2
After=network-online.target edgesniffer-teacher-impulse-parity-v1-capsule-normalizer.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/bot/FinalBot-cya
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /mnt/HC_Volume_106775198/rankerV2EventGatedProspectiveV2.py --mode prospective-v2 --input /var/lib/edgesniffer-teacher-impulse-parity-v1/candidate-capsules.jsonl --out-dir /mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-prospective-shadow-v2 --canonical-spec /mnt/HC_Volume_106775198/edgesniffer-derived/executable-alpha-ranker-v2-canonical-freeze/canonical_score_spec.json --semantic-freeze-manifest /mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-event-gated-semantic-freeze/freeze_manifest.json --atlas-script /mnt/HC_Volume_106775198/memecoinExecutableAlphaAtlasV1.py --self-script /mnt/HC_Volume_106775198/rankerV2EventGatedProspectiveV2.py --poll-ms 10 --read-bytes 65536 --status-every-sec 5
Restart=always
RestartSec=2
NoNewPrivileges=true

[Install]
