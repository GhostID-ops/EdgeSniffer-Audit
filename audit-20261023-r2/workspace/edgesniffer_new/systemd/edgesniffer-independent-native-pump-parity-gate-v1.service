[Unit]
Description=EdgeSniffer native Pump replay parity gate (receive-only research)
After=edgesniffer-independent-native-pump-replay-v1.service edgesniffer-independent-pump-state-bridge-v1.service
Wants=edgesniffer-independent-native-pump-replay-v1.service edgesniffer-independent-pump-state-bridge-v1.service

[Service]
Type=simple
WorkingDirectory=/root/bot/EdgeSniffer
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/bash -c 'while true; do /usr/bin/python3 /root/bot/EdgeSniffer/scripts/auditNativePumpReplayParityV1.py --native /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/native-pre-finality-pump-state-v2.jsonl --finalized /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/native-pump-state-enriched.jsonl --output /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/native-replay-parity-gate.json; sleep 60; done'
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1

[Install]
WantedBy=multi-user.target
