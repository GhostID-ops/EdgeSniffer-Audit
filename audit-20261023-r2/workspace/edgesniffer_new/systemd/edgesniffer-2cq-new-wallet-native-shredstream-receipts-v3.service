[Unit]
Description=EdgeSniffer 2CQ route-candidate native ShredStream receipt capture (receive-only)
After=network-online.target shred-proxy.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/EdgeSniffer
EnvironmentFile=/root/bot/EdgeSniffer/.env
Environment=NATIVE_SHREDSTREAM_GRPC_URL=http://127.0.0.1:9999
Environment=NATIVE_RECEIPT_WALLET=9qz7cWBqYBP2TnGfzMmxX64G4PQip7HtogjPBBnMhWpw
Environment=NATIVE_RECEIPT_MATCH_MODE=route_candidate
Environment=NATIVE_RECEIPT_ROOT=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v9/native-shredstream-route-candidate-receipts-v3
Environment=NATIVE_RECEIPT_HEALTH=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v9/native-shredstream-route-candidate-receipts-v3/observer-health.json
ExecStart=/usr/local/bin/edgesniffer-2cq-new-wallet-native-shredstream-receipts-v3
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v9/native-shredstream-route-candidate-receipts-v3

[Install]
WantedBy=multi-user.target
