[Unit]
Description=Publish separate 2CQ route sibling and Tier-B cohorts (outcome-blind)
After=local-fs.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer/scripts
RuntimeDirectory=edgesniffer-2cq-route-sibling-cohorts-v1
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqRouteSiblingCohortsV1.py --route-state /mnt/HC_Volume_106775198/edgesniffer-research/2cq-route-symmetric-choice-v1/state.sqlite3 --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-route-sibling-cohorts-v1
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-route-symmetric-choice-v1 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-route-sibling-cohorts-v1
TimeoutStartSec=30min
MemoryHigh=2G
MemoryMax=3G
