[Unit]
Description=EdgeSniffer 2CQ new-wallet receive-only exit-intent telemetry shadow
After=network-online.target edgesniffer-2cq-new-wallet-route-source-v1.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/EdgeSniffer
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/captureReceiveOnlyExitIntentTelemetryV1.py --source /mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v8/pump-curve-prospective-windows-v1.jsonl --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v9/shadow-exit-intent-telemetry.jsonl --policy-id PUMP_TOP_LEVEL_0_5_SOL_5S_STRESS50_V1 --entry-delay-seconds 1 --exit-horizon-seconds 5 --interval-seconds 300
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v9

[Install]
WantedBy=multi-user.target
