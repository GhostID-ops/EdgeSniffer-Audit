[Unit]
Description=Publish outcome-blind 2CQ broad behavioral teacher corpus V1
After=local-fs.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer/scripts
RuntimeDirectory=edgesniffer-2cq-broad-behavioral-teacher-corpus-v1
ExecStart=/usr/bin/flock -n -E 75 /run/edgesniffer-2cq-broad-behavioral-teacher-corpus-v1/materialize.lock /usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqBroadBehavioralTeacherCorpusV1.py --source-state /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v3/causal-state-v2.sqlite3 --development-freeze /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v3/development/freeze.json --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-broad-behavioral-teacher-corpus-v1
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v3 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-broad-behavioral-teacher-corpus-v1
TimeoutStartSec=30min
MemoryHigh=2G
MemoryMax=3G
