[Unit]
Description=EdgeSniffer teacher-matched finalized Pump state bridge v3 (receive-only research)
After=network-online.target edgesniffer-independent-teacher-matched-feed-v1.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/bot/EdgeSniffer
EnvironmentFile=/root/bot/EdgeSniffer/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/enrichNativePumpCurveStateV1.py --input /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/teacher-matched-native-observations-v1.jsonl --output /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/native-pump-state-enriched-v3.jsonl --state /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/native-pump-state-enriched-v3.state.json --token2022-state-output /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/token2022-transfer-fee-state-v3.jsonl --start-at-end --poll-ms 250 --workers 8 --batch-size 64
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1

[Install]
WantedBy=multi-user.target
