[Unit]
Description=EdgeSniffer owner-wide native Pump account observer (receive-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/FinalBot-cya/rust-sidecar
EnvironmentFile=/root/bot/FinalBot-cya/.env
Environment=RUST_ONLY_BUYS=true
Environment=RUST_ONLY_SELLS=true
Environment=JUPITER_FALLBACK_ENABLED=false
Environment=RUST_EXECUTOR_ENABLED=false
Environment=RUST_HOT_SNIPER_ENABLED=false
Environment=JITO_SHREDSTREAM_ENABLED=false
Environment=RUST_SIDECAR_JITO_SHREDSTREAM_ENABLED=false
Environment=RUST_SELECTED_CANDIDATE_CURVE_RPC_FALLBACK_ENABLED=false
Environment=RUST_SELECTED_CANDIDATE_SNIPER_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_SUBMIT_ENABLED=false
Environment=RUST_SELECTED_CANDIDATE_NO_SUBMIT_DRY_BUILD_ENABLED=false
Environment=RUST_SELECTED_CANDIDATE_TCP_HOST=127.0.0.1
Environment=RUST_SELECTED_CANDIDATE_TCP_PORT=19103
Environment=RUST_SELECTED_CANDIDATE_CURVE_CACHE_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_CURVE_CACHE_OWNER_WIDE=true
Environment=RUST_SELECTED_CANDIDATE_CURVE_CACHE_REQUIRE_INDEPENDENT=false
Environment=RUST_SELECTED_CANDIDATE_CURVE_GRPC_URLS=https://grpc.va.shyft.to/
Environment=RUST_SELECTED_CANDIDATE_AUDIT_FILE=/mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/native-pump-account-state-events.jsonl
Environment=RUST_SELECTED_CANDIDATE_START_AT_END=true
Environment=SIMULATION_MODE=false
Environment=SHADOW_EXECUTION_MODE=false
ExecStart=/usr/bin/env JITO_SHREDSTREAM_ENABLED=false RUST_SIDECAR_JITO_SHREDSTREAM_ENABLED=false RUST_SELECTED_CANDIDATE_CURVE_RPC_FALLBACK_ENABLED=false /root/bot/FinalBot-cya/rust-sidecar/target/release/pumpfun-sidecar
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1

[Install]
WantedBy=multi-user.target
