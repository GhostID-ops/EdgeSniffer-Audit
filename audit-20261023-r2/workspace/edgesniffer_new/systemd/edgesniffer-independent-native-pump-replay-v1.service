[Unit]
Description=EdgeSniffer native pre-finality Pump reserve replay (receive-only research)
After=network-online.target edgesniffer-teacher-impulse-parity-v1-source-feed.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/bot/EdgeSniffer
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/materializeNativePumpCurveStateV1.py --input /var/lib/edgesniffer-teacher-impulse-parity-v1/normalized-observations.jsonl --output /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/native-pre-finality-pump-state-v2.jsonl --state /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/native-pre-finality-pump-state-v2.state.json --account-seed-input /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/native-curve-account-seeds.jsonl --poll-ms 100 --start-at-end
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1

[Install]
WantedBy=multi-user.target
