[Unit]
Description=EdgeSniffer 2CQ finalized wallet route source (receive-only research)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/bot/EdgeSniffer
EnvironmentFile=/root/bot/EdgeSniffer/.env
Environment=PYTHONUNBUFFERED=1
Environment=TRACKED_WALLET=9qz7cWBqYBP2TnGfzMmxX64G4PQip7HtogjPBBnMhWpw
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/kefi13ArmFinalizedRpcSourceV1.py --tracked-wallet 9qz7cWBqYBP2TnGfzMmxX64G4PQip7HtogjPBBnMhWpw --output /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/2cq-finalized-wallet-source-v1.jsonl --state /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/2cq-finalized-wallet-source-v1.state.json --manifest /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/2cq-finalized-wallet-source-v1.manifest.json --cohort-id 2cq-finalized-wallet-source-v1 --boundary-utc 2026-10-21T00:00:00Z --interval-seconds 5
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1

[Install]
WantedBy=multi-user.target
