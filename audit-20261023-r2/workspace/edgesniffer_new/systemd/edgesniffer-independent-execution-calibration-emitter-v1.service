[Unit]
Description=EdgeSniffer independent calibration candidate emitter
After=network-online.target edgesniffer-independent-pump-state-bridge-v1.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStartPre=/usr/bin/mkdir -p /mnt/HC_Volume_106775198/edgesniffer-derived/independent-execution-calibration-v1
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/emitIndependentCalibrationCandidateV1.py --source /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/native-pump-state-enriched.jsonl --output /mnt/HC_Volume_106775198/edgesniffer-derived/independent-execution-calibration-v1/selected-events.jsonl --buy-lamports 1000000 --max-age-ms 600000 --poll-ms 250
NoNewPrivileges=true
