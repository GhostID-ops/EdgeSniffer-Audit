[Unit]
Description=EdgeSniffer teacher-matched native observation view (receive-only research)
After=network-online.target edgesniffer-teacher-impulse-parity-v1-source-feed.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/bot/EdgeSniffer
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/filterTeacherMatchedObservationFeedV1.py --input /var/lib/edgesniffer-teacher-impulse-parity-v1/normalized-observations.jsonl --output /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/teacher-matched-native-observations-v1.jsonl --state /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/teacher-matched-native-observations-v1.state.json --poll-ms 250 --start-at-end
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1

[Install]
WantedBy=multi-user.target
