[Unit]
Description=EdgeSniffer 2CQ isolated Shyft full-meta prospective capture (outcome-blind)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/EdgeSniffer/rust-exact-ledger
EnvironmentFile=/root/bot/EdgeSniffer/.env
Environment=YELLOWSTONE_FULL_META_ENDPOINT=https://grpc.va.shyft.to/
Environment=YELLOWSTONE_FULL_META_ROOT=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1
ExecStart=/usr/local/bin/edgesniffer-2cq-full-meta-prospective-v1
Restart=on-failure
RestartSec=2
CPUWeight=750
IOWeight=750
MemoryHigh=6G
MemoryMax=8G
OOMScoreAdjust=-400
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0027
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
