[Unit]
Description=EdgeSniffer kEFi fresh replication V7 low-impact materializer
After=edgesniffer-kefi-full-meta-capture-first-v7.service

[Service]
Type=oneshot
User=root
Environment=KEFI_SOURCE_ROOT=/mnt/edgesniffer-kefi-hot/kefi-capture-first-live-v7
Environment=KEFI_PROMOTION_ROOT=/root/kefi-capture-first-promotions-v7
Environment=KEFI_CONTROL_OUT=/root/kefi-capture-first-control-v7
Environment=KEFI_COLLECTOR_UNIT=edgesniffer-kefi-full-meta-capture-first-v7.service
Environment=KEFI_MAX_WINDOWS_PER_CYCLE=4
ExecStart=/usr/local/sbin/edgesniffer-kefi-capture-first-control-v2-runner
Nice=10
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUQuota=100%
IOWeight=10
NoNewPrivileges=true
