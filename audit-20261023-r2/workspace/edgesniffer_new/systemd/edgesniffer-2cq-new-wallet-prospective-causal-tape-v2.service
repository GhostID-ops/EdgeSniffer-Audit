[Unit]
Description=EdgeSniffer confirmed 2CQ wallet prospective causal tape v2 (receive-only)
After=network-online.target edgesniffer-2cq-new-wallet-route-source-v1.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/EdgeSniffer
EnvironmentFile=/root/bot/EdgeSniffer/.env
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/captureWalletProspectiveCausalTapeV1.py --source /mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v1/raw-transactions.jsonl --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v1/prospective-causal-tape-v2.jsonl --state /mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v1/prospective-causal-tape-v2-state.json --cohort-id 2cq-new-wallet-prospective-causal-v2-20261019T000000Z --boundary-utc 2026-10-19T00:00:00Z --interval-seconds 30
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v1

[Install]
WantedBy=multi-user.target
