[Unit]
Description=EdgeSniffer 2CQ hot/cold storage supervisor V1
After=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqResearchStorageSupervisorV1.py --research-root /mnt/HC_Volume_106775198/edgesniffer-research --nfs-root /mnt/edgesniffer-expansion --state /var/lib/edgesniffer/2cq-storage-supervisor-v1/latest.json --target-free-gib 150 --warning-free-gib 100 --emergency-free-gib 50 --dispatch-verified-raw-archive
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/edgesniffer/2cq-storage-supervisor-v1
