[Unit]
Description=EdgeSniffer 2CQ bounded finalized proof prefetch
After=network-online.target edgesniffer-2cq-full-meta-prospective-v1.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqFullMetaCanonicalProofPrefetchV1.py --root /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1 --work-db /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/automation/n-worker.sqlite3 --proof-cache /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/automation/canonical-proof-cache-v1.sqlite3 --report /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/automation/proof-prefetch-latest.json --lock /run/edgesniffer-2cq-full-meta-proof-prefetch-v1.lock --lookahead-acquisitions 2 --max-batch-span-s 120 --max-slots 600 --fetch-workers 8
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1 /run
