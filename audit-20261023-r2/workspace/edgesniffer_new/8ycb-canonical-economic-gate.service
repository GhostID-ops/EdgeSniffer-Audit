[Unit]
Description=8YCB canonical evidence completeness and frozen replay gate
After=8ycb-canonical-pump-tape.service
Requires=8ycb-canonical-pump-tape.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/lib/8ycb-canonical/economic_gate.py --root /var/lib/8ycb-canonical/economics --ledger /var/lib/8ycb-canonical/launch-identity-ledger.jsonl --tape /var/lib/8ycb-canonical/pump-tape/evidence.jsonl --v4-dir /mnt/HC_Volume_106775198/edgesniffer-derived/8ycb-prospective-shadow-v4 --interval 10
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/var/lib/8ycb-canonical/launch-identity-ledger.jsonl
ReadOnlyPaths=/var/lib/8ycb-canonical/pump-tape/evidence.jsonl
ReadOnlyPaths=/mnt/HC_Volume_106775198/edgesniffer-derived/8ycb-prospective-shadow-v4
ReadWritePaths=/var/lib/8ycb-canonical/economics
ReadWritePaths=/var/log/8ycb-canonical
UMask=0077

[Install]
WantedBy=multi-user.target
