[Unit]
Description=EdgeSniffer Ranker V2 one-shot live edge-capture selected-event adapter
After=network-online.target edgesniffer-ranker-v2-prospective-shadow-v2.service edgesniffer-ranker-v2-live-edge-capture-v1.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-live-edge-capture-v1
ExecStart=/usr/bin/python3 /mnt/HC_Volume_106775198/rankerV2LiveEdgeCaptureV1Adapter.py --output /mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-live-edge-capture-v1 --poll-sec 0.25
StandardOutput=append:/mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-live-edge-capture-v1/adapter.stdout.log
StandardError=journal
Restart=no
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
