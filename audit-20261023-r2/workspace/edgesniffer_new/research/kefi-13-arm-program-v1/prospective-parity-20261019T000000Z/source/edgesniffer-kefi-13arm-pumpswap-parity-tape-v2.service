[Unit]
Description=EdgeSniffer KEFI PumpSwap deterministic parity tape v2 (receive-only)
After=network-online.target edgesniffer-kefi-13arm-finalized-rpc-source-v1.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/EdgeSniffer
EnvironmentFile=/root/bot/EdgeSniffer/.env
Environment=TRACKED_WALLET=kEFiAX3jo5NmemysQov342TZ9mGh6yp92GDRjhA8XDf
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/kefi13ArmPumpSwapTapeSourceV1.py --pool-source /mnt/edgesniffer-kefi-hot/kefi-13-arm-multivenue-prospective-20261019T025634Z/raw-transactions.jsonl --output /mnt/edgesniffer-kefi-hot/kefi-13-arm-multivenue-prospective-20261019T025634Z/pumpswap-exact-tape-v4.jsonl --state /mnt/edgesniffer-kefi-hot/kefi-13-arm-multivenue-prospective-20261019T025634Z/pumpswap-tape-state-v4.json --cohort-id kefi-13-arm-parity-prospective-v2 --boundary-utc 2026-10-19T03:43:30.061222Z --interval-seconds 15 --limit 5
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
