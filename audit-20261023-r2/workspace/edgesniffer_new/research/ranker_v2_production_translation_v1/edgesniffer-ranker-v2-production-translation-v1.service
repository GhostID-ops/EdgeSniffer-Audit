[Unit]
Description=EdgeSniffer Ranker V2 production translation no-submit mirror
After=network-online.target edgesniffer-ranker-v2-prospective-shadow-v2.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-production-translation-v1/prospective
Environment=RUST_SELECTED_CANDIDATE_SUBMIT_ENABLED=false
Environment=RANKER_V2_TRANSLATION_PRIORITY_FEE_MICRO_LAMPORTS=0
Environment=READ_ONLY_BLOCKHASH_RPC_URL=https://api.mainnet-beta.solana.com
UnsetEnvironment=PRIVATE_KEY_BASE58 WALLET_PRIVATE_KEY HELIUS_API_KEY JITO_AUTH_UUID JITO_UUID
ExecStart=/usr/bin/python3 /mnt/HC_Volume_106775198/rankerV2ProductionTranslationV1.py service --builder /root/bot/EdgeSniffer/rust-sidecar/target/release/ranker_v2_no_submit_builder --builder-source /root/bot/EdgeSniffer/rust-sidecar/src/bin/ranker_v2_no_submit_builder.rs --output /mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-production-translation-v1/prospective --poll-sec 2
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
