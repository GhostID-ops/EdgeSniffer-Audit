  "cross_mint_selection_applied": false,
  "controls": "same-period non-crossing native Pump buys, teacher label excluded",
  "entry_delay_ms": 1000,
  "sizes_sol": [0.1, 0.5, 1.0],
  "exit_horizons_seconds": [5, 10, 15, 30, 60, 120, 300],
  "selection_performed": false,
  "policy_frozen": false,
  "prospective_validation_required": true,
  "read_only": true,
  "trading_enabled": false
}
