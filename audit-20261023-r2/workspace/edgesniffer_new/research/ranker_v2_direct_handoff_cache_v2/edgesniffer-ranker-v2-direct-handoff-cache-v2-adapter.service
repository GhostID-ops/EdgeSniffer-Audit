[Unit]
Description=EdgeSniffer Ranker V2 direct handoff + authoritative cache v2 adapter
After=network-online.target edgesniffer-ranker-v2-direct-handoff-cache-v2-nosubmit.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/HC_Volume_106775198
ExecStartPre=/usr/bin/mkdir -p /mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-direct-handoff-cache-v2
ExecStart=/usr/bin/python3 /mnt/HC_Volume_106775198/rankerV2LiveEdgeCaptureV1Adapter.py --output /mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-direct-handoff-cache-v2 --poll-sec 0.01 --max-emissions 25 --prewarm-capsules --no-submit-validation --direct-handoff --direct-host 127.0.0.1 --direct-port 19132
StandardOutput=append:/mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-direct-handoff-cache-v2/adapter.stdout.log
StandardError=append:/mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-direct-handoff-cache-v2/adapter.stderr.log
Restart=no
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
