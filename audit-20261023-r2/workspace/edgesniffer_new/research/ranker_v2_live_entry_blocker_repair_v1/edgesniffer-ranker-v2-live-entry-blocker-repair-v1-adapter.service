[Unit]
Description=EdgeSniffer Ranker V2 live-entry blocker repair adapter no-submit validation
After=network-online.target edgesniffer-ranker-v2-live-entry-blocker-repair-v1-nosubmit.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/HC_Volume_106775198
ExecStartPre=/usr/bin/mkdir -p /mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-live-entry-blocker-repair-v1
ExecStart=/usr/bin/python3 /mnt/HC_Volume_106775198/rankerV2LiveEdgeCaptureV1Adapter.py --output /mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-live-entry-blocker-repair-v1 --poll-sec 0.05 --max-emissions 3 --prewarm-capsules --no-submit-validation
StandardOutput=append:/mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-live-entry-blocker-repair-v1/adapter.stdout.log
StandardError=append:/mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-live-entry-blocker-repair-v1/adapter.stderr.log
Restart=no
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
