[Unit]
Description=Read-only EdgeSniffer AUTONOMOUS WHEN V2 operational monitor
After=edgesniffer-2cq-autonomous-when-v2.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqAutonomousWhenV2Monitor.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1

[Install]
WantedBy=multi-user.target
