[Unit]
Description=EdgeSniffer 2CQ AUTONOMOUS WHEN V2 rank-snapshot lane
After=network-online.target edgesniffer-2cq-full-meta-prospective-v1.service
Requires=edgesniffer-2cq-full-meta-prospective-v1.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/EdgeSniffer
Environment=PYTHONPATH=/root/bot/EdgeSniffer/scripts
ExecStart=/usr/bin/python3 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/autonomous-when-v2/source/twoCqAutonomousWhenV2.py --root /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/autonomous-when-v2 --normalizer /root/bot/EdgeSniffer/rust-exact-ledger/target/release/yellowstone_state_plane_normalizer --fingerprint /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/fingerprint-v2-development-v1/frozen-fingerprint.json --env /root/bot/EdgeSniffer/.env --spec /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/autonomous-when-v1/spec.json --boundary /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/autonomous-when-v2/prospective-start-receipt.json
Restart=on-failure
RestartSec=5
Nice=15
CPUWeight=50
IOWeight=50
MemoryMax=384M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1

[Install]
WantedBy=multi-user.target
