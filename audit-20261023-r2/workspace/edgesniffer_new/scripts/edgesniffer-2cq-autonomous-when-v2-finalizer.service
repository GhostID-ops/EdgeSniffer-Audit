[Unit]
Description=EdgeSniffer 2CQ AUTONOMOUS WHEN V2 finalized-slot worker
After=edgesniffer-2cq-autonomous-when-v2.service
Requires=edgesniffer-2cq-autonomous-when-v2.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/EdgeSniffer
Environment=PYTHONPATH=/root/bot/EdgeSniffer/scripts
ExecStart=/usr/bin/python3 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/autonomous-when-v2/source/twoCqAutonomousWhenFinalizerV2.py --root /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/autonomous-when-v2 --env /root/bot/EdgeSniffer/.env
Restart=on-failure
RestartSec=5
Nice=15
CPUWeight=30
IOWeight=30
MemoryMax=192M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1

[Install]
WantedBy=multi-user.target
