[Unit]
Description=8YCB independent canonical Pump evidence tape
After=local-fs.target
RequiresMountsFor=/mnt/HC_Volume_106775198

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/lib/8ycb-canonical/pump_tape.py --source /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1 --root /var/lib/8ycb-canonical/pump-tape --ledger /var/lib/8ycb-canonical/launch-identity-ledger.jsonl --interval 10
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/var/lib/8ycb-canonical/launch-identity-ledger.jsonl
ReadOnlyPaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1
ReadWritePaths=/var/lib/8ycb-canonical/pump-tape
ReadWritePaths=/var/log/8ycb-canonical
UMask=0077

[Install]
WantedBy=multi-user.target
