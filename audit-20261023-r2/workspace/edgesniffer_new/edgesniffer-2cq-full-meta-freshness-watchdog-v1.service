[Unit]
Description=EdgeSniffer 2CQ full-meta freshness watchdog (fail-closed)
After=network-online.target edgesniffer-2cq-full-meta-prospective-v1.service
Wants=network-online.target
RequiresMountsFor=/mnt/HC_Volume_106775198/edgesniffer-research

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/EdgeSniffer
ExecStart=/usr/bin/python3 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/full-meta-freshness-watchdog-v1/source/twoCqFullMetaFreshnessWatchdogV1.py --root /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1 --watch-root /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/full-meta-freshness-watchdog-v1
Restart=on-failure
RestartSec=5
Nice=15
CPUWeight=50
IOWeight=50
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/full-meta-freshness-watchdog-v1 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/incidents

[Install]
WantedBy=multi-user.target
