# Optional friend exposure/sizing preset.
# Apply only if he wants these strategy/accounting values overwritten:
#   npm run env:friend-exposure
#
# Real active keys in this bot:
#   COPY_BUY_PERCENTAGE      replaces old/planned MIRROR_BUY_SCALE
#   MAX_SOL_PER_TOKEN        replaces old/planned MAX_TOKEN_EXPOSURE_SOL
#   MAX_SESSION_DEPLOYED_SOL is active
#   MIN_BUY_BEHAVIOR         is active
#
# These old/planned names are NOT currently read by src/config.ts:
#   MIRROR_BUY_SCALE
#   MAX_BUY_BALANCE_PCT
#   MAX_TOKEN_EXPOSURE_SOL
#
# If he looks for MAX_TOKEN_EXPOSURE_SOL in .env, he will not see it as an active key.
# The active per-token exposure cap is MAX_SOL_PER_TOKEN.

COPY_BUY_PERCENTAGE=100
MIN_BUY_BEHAVIOR=floor
MAX_SOL_PER_TOKEN=0.16
MAX_SESSION_DEPLOYED_SOL=0.75
