[Unit]
Description=EdgeSniffer gap-free global prospective PumpSwap evidence universe V2
After=network-online.target edgesniffer-allenhark-compact-delivery-observer-v1.service
Wants=network-online.target
OnSuccess=edgesniffer-2cq-route-symmetric-choice-v1.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer/scripts
RuntimeDirectory=edgesniffer-pumpswap-global-v2
ExecStart=/usr/bin/flock -n /run/edgesniffer-pumpswap-global-v2/reconcile.lock /usr/bin/python3 /root/bot/EdgeSniffer/scripts/pumpSwapGlobalEvidenceReconcilerV1.py --compact-arrivals /mnt/HC_Volume_106775198/edgesniffer-research/2cq-realtime-delivery-path-localization-v1/allenhark-signature-arrivals-v1.bin --compact-index-state /mnt/HC_Volume_106775198/edgesniffer-research/2cq-launchlab-coverage-v1/launchlab-state-v1.sqlite3 --env /root/bot/EdgeSniffer/.env --output /mnt/HC_Volume_106775198/edgesniffer-research/pumpswap-global-prospective-v2 --limit 10000 --max-signatures 10000 --receipt-backfill-limit 10000
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/root/bot/EdgeSniffer/.env
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/pumpswap-global-prospective-v2
TimeoutStartSec=15min
MemoryHigh=3G
MemoryMax=4G
CPUWeight=5
IOWeight=5
