NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/pump-quote-native-state-v1
TimeoutStartSec=infinity
MemoryHigh=1G
