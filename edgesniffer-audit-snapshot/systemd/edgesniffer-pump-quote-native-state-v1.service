[Unit]
Description=EdgeSniffer non-SOL Pump V2 exact quote-native state plane V1
OnSuccess=edgesniffer-2cq-route-symmetric-choice-v1.service
After=pump-exact-evidence-ledger-v1-reconcile.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer/scripts
RuntimeDirectory=edgesniffer-pump-quote-native-v1
ExecStart=/usr/bin/flock -n /run/edgesniffer-pump-quote-native-v1/materialize.lock /usr/bin/python3 /root/bot/EdgeSniffer/scripts/pumpQuoteNativeStatePlaneV1.py --exact-root /var/lib/pump-exact-evidence-ledger-v1 --compact-arrivals /mnt/HC_Volume_106775198/edgesniffer-research/2cq-realtime-delivery-path-localization-v1/allenhark-signature-arrivals-v1.bin --output /mnt/HC_Volume_106775198/edgesniffer-research/pump-quote-native-state-v1 --minimum-partition 2026/09/11/07 --max-files-per-run 2
