[Unit]
Description=Pump Exact Evidence N-based research readiness tracker
After=pump-exact-evidence-ledger-v1-reconcile.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer/scripts
ExecStart=/usr/bin/flock -n -E 75 /run/pump-exact-offline-v1.lock /bin/sh -c '/usr/bin/python3 /root/bot/EdgeSniffer/scripts/trackPumpExactEvidenceReadinessV1.py /var/lib/pump-exact-evidence-ledger-v1 && /usr/bin/python3 /root/bot/EdgeSniffer/scripts/evaluatePumpExactAlphaReadinessV1.py /var/lib/pump-exact-evidence-ledger-v1 --volume /mnt/HC_Volume_106775198'
SuccessExitStatus=75
Nice=19
IOSchedulingClass=idle
CPUWeight=5
IOWeight=5
IOSchedulingPriority=7
MemoryHigh=1G
MemoryMax=1536M
OOMScoreAdjust=500
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/pump-exact-evidence-ledger-v1/readiness-v1
