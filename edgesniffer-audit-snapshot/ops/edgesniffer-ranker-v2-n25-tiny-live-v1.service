[Service]
Type=simple
WorkingDirectory=/root/bot/FinalBot-cya/rust-sidecar
EnvironmentFile=/root/bot/FinalBot-cya/.env
EnvironmentFile=/etc/edgesniffer-ranker-v2-n25-tiny-live-v1.env
ExecStartPre=/usr/bin/mkdir -p /mnt/HC_Volume_106775198/edgesniffer-derived/ranker-v2-n25-tiny-live-v1
