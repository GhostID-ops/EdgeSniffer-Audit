[Unit]
Description=EdgeSniffer 2CQ prospective Tier-A entry census V3 (AllenHark-clocked, outcome-blind, no-submit)
After=pump-exact-evidence-ledger-v1.service edgesniffer-allenhark-arrival-observer-v1.service
Requires=edgesniffer-allenhark-arrival-observer-v1.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer
RuntimeDirectory=edgesniffer-2cq-tier-a-census-v3
ExecStartPre=/usr/bin/touch /var/lib/pump-exact-evidence-ledger-v1/2cq-direct-detected-swaps-v1.jsonl
ExecStart=/usr/bin/flock -n /run/edgesniffer-2cq-tier-a-census-v3/run.lock /usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqProspectiveTierAEntryCensusV3.py --detector /var/lib/pump-exact-evidence-ledger-v1/2cq-direct-detected-swaps-v1.jsonl --arrival-ledger /var/lib/pump-exact-evidence-ledger-v1/allenhark-arrivals-v1/classified-finalized-pump-arrivals.jsonl --continuity-ledger /var/lib/pump-exact-evidence-ledger-v1/allenhark-arrivals-v1/continuity.jsonl --allenhark-health /var/lib/pump-exact-evidence-ledger-v1/allenhark-arrivals-v1/health.json --exact-root /var/lib/pump-exact-evidence-ledger-v1 --output /var/lib/pump-exact-evidence-ledger-v1/2cq-prospective-tier-a-entry-census-v3 --historical-script /root/bot/EdgeSniffer/scripts/twoCqCausalEntryTimingFingerprintV1.py --historical-report /mnt/HC_Volume_106775198/edgesniffer-research/2cq-teacher-validation/2CQ_CAUSAL_ENTRY_TIMING_FINGERPRINT_V1/report.json
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/pump-exact-evidence-ledger-v1
PrivateTmp=true
