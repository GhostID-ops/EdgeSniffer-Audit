[Unit]
Description=EdgeSniffer Rule A controlled live dust validation v1
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/bot/FinalBot-cya/rust-sidecar
EnvironmentFile=/root/bot/FinalBot-cya/.env

# Live validation posture: Rust owns detection/selection/execution. No file-tail
# or selected-event adapter is allowed to authorize buys for this test.
Environment=SIMULATION_MODE=false
Environment=SHADOW_EXECUTION_MODE=false
Environment=RUST_ONLY_BUYS=true
Environment=RUST_ONLY_SELLS=true
Environment=JUPITER_FALLBACK_ENABLED=false
Environment=RUST_SIDECAR_YELLOWSTONE_ENABLED=true
Environment=RUST_SIDECAR_GRPC_URL=https://grpc.va.shyft.to/
Environment=RUST_EXECUTOR_ENABLED=true
Environment=RUST_HOT_SNIPER_ENABLED=false
Environment=RUST_SELECTED_CANDIDATE_SNIPER_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_SUBMIT_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_NO_SUBMIT_DRY_BUILD_ENABLED=false
Environment=RUST_SELECTED_CANDIDATE_DISABLE_HOT_SNIPER=true
Environment=RUST_SELECTED_CANDIDATE_SOURCE=
Environment=RUST_SELECTED_CANDIDATE_REQUIRED_SHADOW_LANE=
Environment=RUST_SELECTED_CANDIDATE_REQUIRED_SHADOW_POLICY=
Environment=RUST_SELECTED_CANDIDATE_RESERVE_OBSERVATION_SOURCE=
Environment=RUST_SELECTED_CANDIDATE_TCP_HOST=127.0.0.1
Environment=RUST_SELECTED_CANDIDATE_TCP_PORT=19111
Environment=TEACHER_IMPULSE_PRODUCTION_CANDIDATE_RULE_A_ENABLED=true
Environment=TEACHER_IMPULSE_PRODUCTION_CANDIDATE_RULE_A_LIVE_VALIDATION_ENABLED=true
Environment=TEACHER_IMPULSE_PARITY_DIR=/var/lib/edgesniffer-teacher-impulse-parity-v1
Environment=RUST_SELECTED_CANDIDATE_AUDIT_FILE=/var/lib/edgesniffer-teacher-impulse-parity-v1/live-rule-a-dust-v2/rust-selected-candidate-audit.jsonl

# Rule A validation bounds.
Environment=RUST_SELECTED_CANDIDATE_BUY_SOL=0.001
Environment=RUST_SELECTED_CANDIDATE_MAX_OPEN=1
Environment=RUST_SELECTED_CANDIDATE_MAX_SESSION_BUYS=25
Environment=RUST_SELECTED_CANDIDATE_MAX_LANDED_BUYS=10

# Dust validation fee safety. These override hot production fee settings from
# .env and are guarded again in ExecStartPre before any transaction can submit.
Environment=RUST_SELECTED_CANDIDATE_CAP_FEE_OVERRIDES_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_MAX_FEE_PCT_OF_BUY=10
Environment=RUST_SELECTED_CANDIDATE_BUY_USE_HOT_FEE_PROFILE=false
Environment=RUST_SELECTED_CANDIDATE_BUY_PRIORITY_FEE_MICRO_LAMPORTS=0
Environment=RUST_SELECTED_CANDIDATE_BUY_JITO_TIP_LAMPORTS=0
Environment=RUST_SELECTED_CANDIDATE_BUY_HELIUS_TIP_LAMPORTS=0
Environment=RUST_SELECTED_CANDIDATE_SELL_USE_HOT_FEE_PROFILE=false
Environment=RUST_SELECTED_CANDIDATE_SELL_PRIORITY_FEE_MICRO_LAMPORTS=0
Environment=RUST_SELECTED_CANDIDATE_SELL_JITO_TIP_LAMPORTS=0
Environment=RUST_SELECTED_CANDIDATE_SELL_HELIUS_TIP_LAMPORTS=0
Environment=RUST_SELECTED_CANDIDATE_ENFORCE_ZERO_EXECUTION_FEES=true
Environment=RUST_SELECTED_CANDIDATE_ENFORCE_ZERO_SELL_FEES=true

# Authority and buy guards.
Environment=RUST_SELECTED_CANDIDATE_CURVE_CACHE_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_CURVE_CACHE_OWNER_WIDE=false
Environment=RUST_SELECTED_CANDIDATE_CURVE_CACHE_REQUIRE_INDEPENDENT=true
Environment=RUST_SELECTED_CANDIDATE_CURVE_GRPC_URLS=https://grpc.va.shyft.to/
Environment=RUST_SELECTED_CANDIDATE_CURVE_CACHE_WAIT_MS=25
Environment=RUST_SELECTED_CANDIDATE_CURVE_CACHE_MAX_AGE_MS=250
Environment=RUST_SELECTED_CANDIDATE_CURVE_RPC_FALLBACK_ENABLED=false
Environment=RUST_SELECTED_CANDIDATE_SEND_TIME_CURVE_REFRESH_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_SEND_TIME_CURVE_CACHE_REQUIRED=true
Environment=RUST_SELECTED_CANDIDATE_SEND_TIME_SELECTED_EVENT_FALLBACK_ENABLED=false
Environment=RUST_SELECTED_CANDIDATE_FILL_FIRST_FINAL_GUARD_YELLOWSTONE_REQUIRED=true
Environment=RUST_SELECTED_CANDIDATE_FILL_FIRST_ALLOW_SELECTED_EVENT_FALLBACK=false
Environment=RUST_SELECTED_CANDIDATE_BUY_OUTPUT_POLICY=fill_first
Environment=RUST_SELECTED_CANDIDATE_PRE_SIGN_ECONOMIC_GUARD_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_PRE_SIGN_MAX_EXPECTED_OUTPUT_DROP_BPS=2500
Environment=RUST_SELECTED_CANDIDATE_FINAL_GUARD_TO_BUY_START_MAX_MS=150

# Sell Fix V1.1 / inventory reconciliation posture.
Environment=RUST_EXIT_WATCHER_ENABLED=true
Environment=RUST_EXIT_SUBSCRIPTION_REFRESH_MS=25
Environment=RUST_EXIT_POLL_FALLBACK_ENABLED=true
Environment=RUST_EXIT_POLL_FALLBACK_MS=250
Environment=RUST_SELECTED_CANDIDATE_EXIT_TAKE_PROFIT_PCT=20
Environment=RUST_SELECTED_CANDIDATE_EXIT_TAKE_PROFIT_SELL_PCT=100
Environment=RUST_SELECTED_CANDIDATE_EXIT_STOP_LOSS_PCT=-20
Environment=RUST_SELECTED_CANDIDATE_EXIT_STOP_LOSS_GRACE_MS=0
Environment=RUST_SELECTED_CANDIDATE_EXIT_MAX_HOLD_MS=120000
Environment=RUST_SELECTED_CANDIDATE_EXIT_SELL_SLIPPAGE_BPS=500
Environment=RUST_SELECTED_CANDIDATE_EXIT_PUMPFUN_SELL_TRADE_FEE_BPS=125
Environment=RUST_SELECTED_CANDIDATE_EXIT_NORMAL_TP_CAPTURE_SLIPPAGE_BPS=500
Environment=RUST_SELECTED_CANDIDATE_EXIT_SEND_TIME_QUOTE_REFRESH_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_EXIT_SEND_TIME_CURVE_CACHE_MAX_AGE_MS=75
Environment=RUST_SELECTED_CANDIDATE_EXIT_SEND_TIME_SELL_SLIPPAGE_BPS=500
Environment=RUST_SELECTED_CANDIDATE_EXIT_MIN_ACCEPTABLE_TP_PNL_PCT=5
Environment=RUST_SELECTED_CANDIDATE_EXIT_TP_6003_SALVAGE_MIN_PNL_PCT=5
Environment=RUST_SELECTED_CANDIDATE_EXIT_TP_6003_SALVAGE_MIN_REALIZED_PNL_PCT=5
Environment=RUST_SELECTED_CANDIDATE_EXIT_TP_6003_RETRY_CURVE_CACHE_MAX_AGE_MS=75
Environment=RUST_SELECTED_CANDIDATE_RETRY_TP_6003_BEFORE_FLATTEN=true
Environment=RUST_SELECTED_CANDIDATE_TP_6003_PROTECTED_RETRIES=1
Environment=RUST_SELECTED_CANDIDATE_SELL_STATUS_TIMEOUT_MS=2000
Environment=RUST_SELECTED_CANDIDATE_SELL_STATUS_POLL_MS=50
Environment=RUST_SELECTED_CANDIDATE_BUY_STATUS_TIMEOUT_MS=2000
Environment=RUST_SELECTED_CANDIDATE_BUY_STATUS_POLL_MS=50
Environment=RUST_SELECTED_CANDIDATE_EXACT_BALANCE_PROOF_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_EXACT_BALANCE_PROOF_TIMEOUT_MS=2000
Environment=RUST_SELECTED_CANDIDATE_EXACT_BALANCE_PROOF_POLL_MS=10
Environment=RUST_SELECTED_CANDIDATE_EXACT_BALANCE_PROOF_RPC_TIMEOUT_MS=80
Environment=RUST_SELECTED_CANDIDATE_DIRECT_ATA_BALANCE_PROBE_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_DIRECT_ATA_BALANCE_PROBE_PER_CANDIDATE_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_BALANCE_CACHE_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_BALANCE_CACHE_WALLET_OWNER_STREAM_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_BALANCE_GRPC_URLS=https://grpc.shyft.to,https://grpc.va.shyft.to
Environment=RUST_SELECTED_CANDIDATE_BALANCE_CACHE_WAIT_MS=250
Environment=RUST_SELECTED_CANDIDATE_BALANCE_CACHE_MAX_AGE_MS=2000
Environment=RUST_SELECTED_CANDIDATE_BALANCE_CACHE_RPC_FALLBACK_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_ALLOW_PRE_PROOF_SELL_BROADCAST=false
Environment=RUST_SELECTED_CANDIDATE_UNSAFE_PRE_PROOF_SELL_BROADCAST_ENABLED=false
Environment=RUST_SELECTED_CANDIDATE_PRE_PROOF_SELL_REQUIRE_LOCAL_LANDED=true
Environment=RUST_SELECTED_CANDIDATE_LANDED_SAFE_EXIT_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_LANDED_SAFE_EXIT_TIMEOUT_MS=400
Environment=RUST_SELECTED_CANDIDATE_LANDED_SAFE_EXIT_POLL_MS=10
Environment=RUST_SELECTED_CANDIDATE_LANDED_SAFE_EXIT_HISTORY_FALLBACK_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_LANDED_SAFE_EXIT_RPC_FALLBACK_ENABLED=false
Environment=RUST_SELECTED_CANDIDATE_GUARANTEED_MIN_OUT_EXIT_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_GUARANTEED_MIN_OUT_EXIT_BPS=9800
Environment=RUST_SELECTED_CANDIDATE_WALLET_RECONCILE_ENABLED=true
Environment=RUST_SELECTED_CANDIDATE_WALLET_RECONCILE_AUTO_FLATTEN_ENABLED=false
Environment=RUST_SELECTED_CANDIDATE_WALLET_RECONCILE_INTERVAL_MS=5000
Environment=RUST_SELECTED_CANDIDATE_WALLET_RECONCILE_UNMANAGED_GRACE_MS=60000

ExecStartPre=/usr/bin/mkdir -p /var/lib/edgesniffer-teacher-impulse-parity-v1/live-rule-a-dust-v2
ExecStartPre=/usr/bin/bash -lc 'set -euo pipefail; buy_lamports=1000000; cap_enabled="${RUST_SELECTED_CANDIDATE_CAP_FEE_OVERRIDES_ENABLED:-}"; max_pct="${RUST_SELECTED_CANDIDATE_MAX_FEE_PCT_OF_BUY:-}"; buy_priority="${RUST_SELECTED_CANDIDATE_BUY_PRIORITY_FEE_MICRO_LAMPORTS:-}"; buy_jito="${RUST_SELECTED_CANDIDATE_BUY_JITO_TIP_LAMPORTS:-}"; buy_helius="${RUST_SELECTED_CANDIDATE_BUY_HELIUS_TIP_LAMPORTS:-}"; sell_priority="${RUST_SELECTED_CANDIDATE_SELL_PRIORITY_FEE_MICRO_LAMPORTS:-}"; sell_jito="${RUST_SELECTED_CANDIDATE_SELL_JITO_TIP_LAMPORTS:-}"; sell_helius="${RUST_SELECTED_CANDIDATE_SELL_HELIUS_TIP_LAMPORTS:-}"; test "$cap_enabled" = true; test "$max_pct" = 10; test -n "$buy_priority"; test -n "$buy_jito"; test -n "$buy_helius"; test -n "$sell_priority"; test -n "$sell_jito"; test -n "$sell_helius"; test "${RUST_SELECTED_CANDIDATE_BUY_USE_HOT_FEE_PROFILE:-}" = false; test "${RUST_SELECTED_CANDIDATE_SELL_USE_HOT_FEE_PROFILE:-}" = false; test "${RUST_SELECTED_CANDIDATE_ENFORCE_ZERO_EXECUTION_FEES:-}" = true; test "${RUST_SELECTED_CANDIDATE_ENFORCE_ZERO_SELL_FEES:-}" = true; max_fee=$((buy_lamports * 10 / 100)); buy_optional=$((buy_jito + buy_helius + (buy_priority * 1400000 + 999999) / 1000000)); sell_optional=$((sell_jito + sell_helius + (sell_priority * 1400000 + 999999) / 1000000)); test "$buy_optional" -le "$max_fee"; test "$sell_optional" -le "$max_fee"; echo "{\"kind\":\"ruleADustFeeGuardVerified\",\"buySol\":0.001,\"buyLamports\":$buy_lamports,\"feeCapEnabled\":true,\"maxFeePctOfBuy\":10,\"maxOptionalFeeLamports\":$max_fee,\"buyJitoTipLamports\":$buy_jito,\"buyHeliusTipLamports\":$buy_helius,\"buyPriorityFeeMicroLamports\":$buy_priority,\"buyOptionalFeeLamports\":$buy_optional,\"sellJitoTipLamports\":$sell_jito,\"sellHeliusTipLamports\":$sell_helius,\"sellPriorityFeeMicroLamports\":$sell_priority,\"sellOptionalFeeLamports\":$sell_optional}" >> /var/lib/edgesniffer-teacher-impulse-parity-v1/live-rule-a-dust-v2/rust-selected-candidate-audit.jsonl'
ExecStart=/root/bot/FinalBot-cya/rust-sidecar/target/release/pumpfun-sidecar
StandardOutput=append:/var/lib/edgesniffer-teacher-impulse-parity-v1/live-rule-a-dust-v2/stdout.jsonl
StandardError=journal
Restart=no
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
