Environment=ALLENHARK_SHREDSTREAM_GRPC_URL=http://127.0.0.1:9999
Environment=ALLENHARK_2CQ_CAPTURE_FIRST_ROOT=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-capture-first-detector-repair-v1/prospective
