[Unit]
Description=EdgeSniffer 8YCB immutable V3 production translation (build-only, no submit)
After=network-online.target edgesniffer-8ycb-prospective-shadow-v3.service
Wants=network-online.target

[Service]
Type=simple
User=edgeshadow8ycbtx
Group=edgeshadow8ycb
WorkingDirectory=/mnt/HC_Volume_106775198/edgesniffer-derived/8ycb-production-translation-v1/prospective
Environment=PYTHONUNBUFFERED=1
Environment=READ_ONLY_BLOCKHASH_RPC_URL=https://api.mainnet-beta.solana.com
Environment=RUST_ONLY_BUYS=true
Environment=RUST_ONLY_SELLS=true
Environment=JUPITER_FALLBACK_ENABLED=false
Environment=RUST_EXECUTOR_ENABLED=false
Environment=RUST_SELECTED_CANDIDATE_SUBMIT_ENABLED=false
UnsetEnvironment=PRIVATE_KEY_BASE58 WALLET_PRIVATE_KEY HELIUS_API_KEY JITO_AUTH_UUID JITO_UUID
ExecStart=/usr/bin/python3 /usr/local/lib/edgesniffer-8ycb-production-translation-v1/production_shadow.py service --ledger /mnt/HC_Volume_106775198/edgesniffer-derived/8ycb-prospective-shadow-v3/cohort_ledger.jsonl --builder /usr/local/lib/edgesniffer-8ycb-production-translation-v1/eight_ycb_no_submit_builder --output /mnt/HC_Volume_106775198/edgesniffer-derived/8ycb-production-translation-v1/prospective
Restart=always
RestartSec=2
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/mnt/HC_Volume_106775198/edgesniffer-derived/8ycb-prospective-shadow-v3
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-derived/8ycb-production-translation-v1/prospective
InaccessiblePaths=/root/bot /root/.ssh

[Install]
WantedBy=multi-user.target
