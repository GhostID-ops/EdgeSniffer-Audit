# Required: Helius API key (for read RPC: blockhash, ALTs)
HELIUS_API_KEY=7ef390b3-2215-4e19-8933-3d4bc7a62a25

# Required: Wallet private key in base58
PRIVATE_KEY_BASE58=4HLJyAr4ibWRYUY9V9eRKZcsjnjAtR2oSgystDj5xe2n7GGupw4Jz2qMnKDWPrNcvray5Pbqs83boZMZMKq8Ycqj

# Optional: Sender endpoint (default: http://ewr-sender.helius-rpc.com/fast)
# Note: previous dedicated Sender (meade-nrtn8f-...) was tied to the prior plan; using public Sender now.
SENDER_ENDPOINT=http://ewr-sender.helius-rpc.com/fast

# Optional: Secure RPC URL for better performance (Helius Gatekeeper beta — lowest-latency routing).
SECURE_RPC_URL=https://beta.helius-rpc.com/?api-key=7ef390b3-2215-4e19-8933-3d4bc7a62a25

# Optional: Helius WebSocket URL for push-based swap detection (near-instant vs polling).
WEBSOCKET_URL=wss://mainnet.helius-rpc.com/?api-key=7ef390b3-2215-4e19-8933-3d4bc7a62a25

# Optional: Tip amount in lamports (Helius now requires minimum 200,000 = 0.0002 SOL)
# Higher tip = faster inclusion. Recommended: 500,000-1,000,000 for fast execution
TIP_LAMPORTS=3000000

# Optional: Priority fee in microLamports per CU (default: 50000). Overrides Jupiter's advisory fee.
# Higher priority fee = faster processing. Recommended: 200,000-500,000 for speed
PRIORITY_FEE_MICRO_LAMPORTS=2000000

# Optional: Compute Unit Limit override. 0 keeps Jupiter's dynamic estimate (recommended).
COMPUTE_UNIT_LIMIT=0

# Optional: Skip transaction confirmation for maximum speed (true = fastest, false = wait for confirmation)
# WARNING: Skipping confirmation means trades may fail silently, but much faster execution
FAST_MODE=false

# Copytrading: wallet addresses to copy (comma-separated) CyaE1VxvBrahnPWkqm5VsdCvyS2QmNht2UFrKJHga54o
TRACKED_WALLETS=CyaE1VxvBrahnPWkqm5VsdCvyS2QmNht2UFrKJHga54o
#CyaE1VxvBrahnPWkqm5VsdCvyS2QmNht2UFrKJHga54o
#4BdKaxN8G6ka4GYtQQWk4G4dZRUTX2vQH9GcXdBREFUk
#83Vw4rWynW84m6tnz1rCsCkRavxgnH9JGAmYLxq7CeR8, CyaE1VxvBrahnPWkqm5VsdCvyS2QmNht2UFrKJHga54o,4BdKaxN8G6ka4GYtQQWk4G4dZRUTX2vQH9GcXdBREFUk
# Copytrading: min/max mirror size in SOL. Trades below min are skipped; trades above max are capped to max.
MIN_BUY_SOL=0.25
MAX_BUY_SOL=0.3

# SOL Reserve: Keep this amount of SOL available for gas fees (prevents wallet from going to 0)
SOL_RESERVE=1

# Optional: Swap params (used by npm run swap). Defaults: SOL -> USDC, 0.001 SOL, 50 bps slippage.
# SWAP_INPUT_MINT=So11111111111111111111111111111111111111112
# SWAP_OUTPUT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# SWAP_AMOUNT=1000000
# SWAP_SLIPPAGE_BPS=50

# Copytrading slippage. 500 = 5%; retry is used once if Jupiter fails with 6001 slippage.
MIRROR_SLIPPAGE_BPS=1200
MIRROR_RETRY_SLIPPAGE_BPS=2000

SIMULATION_MODE=true
STARTING_SOL_BALANCE=5

# Poll fallback interval in ms (WebSocket does the fast path). High value = minimal API credit burn. Default 2500.
POLL_INTERVAL_MS=500

# When false, source-wallet sells are NOT auto-mirrored. You exit manually via 'e' or 'a' keys. Default true.
MIRROR_SELLS=true

# When true, copy-sells try 100% of live token balance first. If preflight fails, the bot retries buffered sizes.
# Set false to go back to always selling 99.8% first.
COPY_SELL_FULL_BALANCE=true

# Skip copy-sells when the quote would receive less SOL than this.
# Prevents paying fast-lane fees to sell worthless dust.
MIN_SELL_OUTPUT_SOL=0.01

# When true (default), only one buy per token mint per session — avoids pyramiding the same coin.
# Toggle at runtime with the 'b' key.
BUY_ONCE_PER_TOKEN=true

# Show market cap from DexScreener whenever available. ON by default. Note: can be inaccurate for
# fresh pump.fun tokens (wrong pool, stale data). Toggle at runtime with the 'c' key.
SHOW_MARKET_CAP=false

# Telegram Notifications (optional)
# Get your bot token from @BotFather: /newbot
# Get your chat ID from: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=8704923679:AAH2JIteI_QciVDNWDKoDvINUUj_TBrKMqU
TELEGRAM_CHAT_ID=1467835378

# gRPC values
GEYSER_ENDPOINT=http://grpc-ny6-1.erpc.global
#GEYSER_X_TOKEN=
#ERPC_RPC_URL=

# Telegram User API (for sniper signal listener via GramJS).
# api_id / api_hash from https://my.telegram.org → API development tools.
# Treat TELEGRAM_API_HASH like a password.
TELEGRAM_API_ID=19242649
TELEGRAM_API_HASH=597d7cad6520f64a09256b2b4cbb319c
# Filled in after running the one-time login script (snipeLogin).
TELEGRAM_USER_
# Numeric channel ID (e.g. -1001234567890) or @username of the alpha channel.
SNIPE_CHANNEL=-1002283583053
# Snipe filters / sizing.
SNIPE_BUY_SOL=1
# 0 disables this filter dimension (any per-post Boost Amount passes).
MIN_BOOST_AMOUNT=10
# Cumulative boosts the project has ever bought; signal must meet this to fire.
# Integer only — decimals get truncated silently.
MIN_TOTAL_BOOSTS=1
# Upper bound on Total Boosts. 0 = no cap. Set to 1 to ONLY snipe first-ever
# channel mentions (highest forward upside per the data analysis).
MAX_TOTAL_BOOSTS=60
# Safety: when true, parser & filter run but no buy is broadcast. Flip to false to go live.
SNIPE_DRY_RUN=true

# Auto-exit: poll open positions and sell when TP or SL is hit. Works in both
# live and dry-run mode (dry-run uses Jupiter quotes, no SOL spent).
SNIPE_AUTO_EXIT=false
# Hard take-profit cap (sells the whole position when this is hit).
SNIPE_TAKE_PROFIT_PCT=200
# Initial stop loss (rug protection before any pump). Replaced by trailing
# levels below once the position pumps.
SNIPE_STOP_LOSS_PCT=30
# Trailing stop levels: comma-separated trigger:lock pairs.
#   trigger = peak gain % at which the SL ratchets up
#   lock    = new SL level (positive = locked-in profit, 0 = break-even)
# Example below: at +50% peak → SL becomes 0% (break-even, no losses on a position
# that already pumped 50%). At +100% peak → SL becomes +50% (lock half the gain).
# At +150% peak → SL becomes +100% (locked +100% profit, let it ride to TP=200%).
SNIPE_TRAILING_LEVELS=50:0,100:50,150:100
# How often (ms) to poll Jupiter for each open position. 8000 = every 8s.
SNIPE_MONITOR_INTERVAL_MS=8000

