# Infra execution engine patch.
# Safe to apply on top of an existing .env with:
#   npm run env:infra-engine

SENDER_RPC_FALLBACK_ENABLED=true
EXECUTION_MULTI_SEND_ENABLED=false
EXECUTION_RESCUE_RETRIES=2
EXECUTION_RESCUE_DELAY_MS=25
EXECUTION_ALT_ADDRESSES=
EXECUTION_TIP_MULTIPLIERS=buy:1.15,sell:0.9,pumpfun-source-replay-buy:1.25,pumpfun-direct-buy:1.2,pumpswap-direct-buy:1.15,jupiter-buy:1,pumpfun-direct-sell:0.9,pumpfun-direct-sell-v2:1,pumpswap-direct-sell:0.95,jupiter-sell:0.9

EXECUTION_TELEMETRY_ENABLED=true
EXECUTION_TELEMETRY_PATH=data/execution-telemetry.jsonl

WARM_WALLET_MODE=true
KEEP_WSOL_ATA_OPEN=true
