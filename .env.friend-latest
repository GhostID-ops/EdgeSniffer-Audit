# Friend latest non-secret env patch.
# Safe to apply on top of an existing .env with:
#   npm run env:friend-latest
#
# This intentionally does NOT set:
# PRIVATE_KEY_BASE58, LICENSE_KEY, HELIUS_API_KEY, SHYFT_GRPC_X_TOKEN,
# SECURE_RPC_URL, WEBSOCKET_URL, TRACKED_WALLETS, or Telegram secrets.

# gRPC / RabbitStream detection
SHYFT_GRPC_ENABLED=true
SHYFT_GRPC_URL=https://grpc.ny.shyft.to
SHYFT_GRPC_COMMITMENT=processed
SHYFT_GRPC_RECONNECT_MS=1000
SHYFT_RABBITSTREAM_ENABLED=true
SHYFT_RABBITSTREAM_URL=https://rabbitstream.ny.shyft.to/

# Disable Helius enhanced websocket/history hot-path usage for friends with no Helius credits.
HELIUS_TX_SUBSCRIBE_ENABLED=false
HELIUS_TX_SUBSCRIBE_URL=
SKIP_SOURCE_PREEXISTING_MINTS=true
SOURCE_PREEXISTING_SCAN_TX_LIMIT=0

# Execution landing / retry engine
SENDER_ENDPOINT=http://ewr-sender.helius-rpc.com/fast
FAST_MODE=true
BROADCAST_RACE_ENABLED=true
SENDER_RPC_FALLBACK_ENABLED=true
EXECUTION_MULTI_SEND_ENABLED=false
EXECUTION_RESCUE_RETRIES=2
EXECUTION_RESCUE_DELAY_MS=25
EXECUTION_ALT_ADDRESSES=
EXECUTION_TIP_MULTIPLIERS=pumpfun-direct-buy:1,pumpswap-direct-buy:1,pumpfun-direct-sell:1,pumpswap-direct-sell:1,jupiter-buy:1,jupiter-sell:1

# Runtime telemetry
EXECUTION_TELEMETRY_ENABLED=true
EXECUTION_TELEMETRY_PATH=data/execution-telemetry.jsonl

# Wallet/account warmup
WARM_WALLET_MODE=true
KEEP_WSOL_ATA_OPEN=true

# Fee / landing defaults
TIP_LAMPORTS=2500000
PRIORITY_FEE_MICRO_LAMPORTS=350000
DYNAMIC_PRIORITY_FEE_ENABLED=true
DYNAMIC_PRIORITY_FEE_REFRESH_MS=5000
DYNAMIC_PRIORITY_FEE_MAX_MICROLAMPORTS=1000000
COMPUTE_UNIT_LIMIT=1000000
USE_JITO_DIRECT=true
USE_JITO_FALLBACK=true
JITO_REGION=ny
JITO_REGIONS=ny
JITO_REGION_RACE_ENABLED=true

# Direct route defaults
PUMPFUN_EXACT_SOL_IN_BUYS=true
PUMPSWAP_DIRECT_BUY_ENABLED=true
PUMPSWAP_DIRECT_MIN_OUT_BPS=0
PUMPSWAP_DIRECT_PREFLIGHT=true
MIRROR_GRADUATED_BUYS=true

# Jupiter fallback protection
MAX_ENTRY_PRICE_IMPACT_PCT=60
MIRROR_SLIPPAGE_BPS=6000
MIRROR_RETRY_SLIPPAGE_BPS=10000
JUPITER_QUOTE_MIN_GAP_MS=650
JUPITER_QUOTE_429_COOLDOWN_MS=8000
JUPITER_QUOTE_RETRIES=1
JUPITER_OVERSIZE_MAX_ACCOUNTS=56,52,48,44,40,36,32,28,24,20,16

# Core strategy/risk defaults copied from the current main setup.
MIN_BUY_SOL=0.25
MAX_BUY_SOL=0.3
COPY_BUY_PERCENTAGE=100
MIN_BUY_BEHAVIOR=allow
MIRROR_QUOTE_ASSET=MATCH
SOL_RESERVE=0.01
MAX_OPEN_POSITIONS=3
BUY_ONCE_PER_TOKEN=true
MAX_BUYS_PER_TOKEN=1
MAX_SOL_PER_TOKEN=0.30
MAX_SESSION_DEPLOYED_SOL=0.75
MIRROR_SELLS=false
STOP_LOSS_PCT=45
TAKE_PROFIT_PCT=
TRAILING_STEPS=60:15,100:40,160:85,250:150,400:260,700:500
MIN_HOLD_BEFORE_STOP_LOSS_MS=12000
RISK_FAST_INTERVAL_MS=400
RISK_FAST_WINDOW_MS=20000
RISK_NEAR_TRIGGER_INTERVAL_MS=400
RISK_NORMAL_INTERVAL_MS=1000
RISK_NEAR_TRIGGER_PCT=8
RISK_DRIFT_PCT_PER_SEC=5
MAX_RISK_QUOTES_PER_CHECK=1
