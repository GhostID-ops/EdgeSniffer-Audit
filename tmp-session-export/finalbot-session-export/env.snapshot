# RPC and sender
# Sender stays on Helius � Shyft has no equivalent specialized broadcast service.
#SECURE_RPC_URL=https://ferne-h6cboy-fast-mainnet.helius-rpc.com
#WEBSOCKET_URL=wss://mainnet.helius-rpc.com/?api-key=b9b46cea-ef95-43a7-b23d-6081123c62ba

# Jito ShredStream input for the Rust sidecar.
# Requires jito-shredstream-proxy running with --grpc-service-port 9999 and a sidecar binary
# built with: npm run rust-sidecar:jito-build

# Extra Helius race feed. This does not replace Shyft gRPC/RabbitStream; whichever feed detects a
# valid source-wallet swap first wins through the shared signature dedupe.

# --- Phase 2: Jito BlockEngine direct submission ---
# Off by default. When enabled, broadcasts go straight to Jito's bundle endpoint instead of
# Helius Sender (which forwards bundles to Jito with one extra hop). Saves ~50-100ms when
# Jito accepts the bundle; falls back to Helius Sender on Jito error if USE_JITO_FALLBACK=true.

# --- Token-2022 direct sell (pump.fun sell_v2 path) ---
# When enabled, Token-2022 pump.fun sells use pump.fun's sell_v2 directly (no Jupiter fallback).
# Uses hardcoded fee + buyback recipient constants discovered via on-chain analysis.
# Sim-tested ?. Live-test on a small position before relying on it.
# If pump.fun rotates the constants, sells will start failing � disable to fall back to Jupiter.
# dont forget to add a 0 to micro_lamports
# Hard ceiling on the dynamic priority fee (micWroLamports per CU). Caps the oracle so a single
# contended block can't bid 200M �L/CU and burn 0.019 SOL on one tx.
# At ~95K CU consumed per typical tx, the SOL cost per tx scales as:
#      1,000,000 �L/CU  ?  0.0001 SOL per tx   (very tight, may miss hot launches)
#      5,000,000 �L/CU  ?  0.0005 SOL per tx   ? current � fits 0.05-0.19 SOL trade size
#     10,000,000 �L/CU  ?  0.001  SOL per tx
#     50,000,000 �L/CU  ?  0.005  SOL per tx   ? good for 0.5-1.0 SOL trade size
#    100,000,000 �L/CU  ?  0.010  SOL per tx   ? aggressive, for 1+ SOL bets in tip-war territory
# When you move to 0.5+ SOL bets, comment the line above and uncomment ONE below:
#DYNAMIC_PRIORITY_FEE_MAX_MICROLAMPORTS=50000000   # 0.005 SOL/tx max � recommended for 0.5-1.0 SOL bets
#DYNAMIC_PRIORITY_FEE_MAX_MICROLAMPORTS=100000000  # 0.010 SOL/tx max � for 1+ SOL bets, hot-launch wars



# Copytrading sizing and behavior
# Fixed-size cluster copy profile. COPY_BUY_PERCENTAGE is intentionally unset;
# sizing is controlled by these SOL caps instead.
# Optional exit signal wallets:
# Disabled by default. When enabled, these wallets are watched for SELLS only.
# If one sells a mint we currently hold, the bot closes our matching position.
# Their buys are ignored, so do not use this as a second buy-source list.
#EXIT_SIGNAL_WALLETS=GUgMNi2tJcjYpDSFs2VZQpjryeWRG4Xgmi1JPDEoe1TH,5ATd36Tdq6zrtHBokC5moRs9Y5EFSNaZQ12fzRmTeNWd
# Startup-only DCA guard: skip mints te tracked wallet already holds or recently bought.
# If a direct buy confirms failed on-chain, try one rescue buy through Jupiter only.
# Only buy graduated pump.fun tokens through Jupiter when explicitly enabled.
# Alias supported by code too: BUY_GRADUATED_TOKENS=true
# Use pump.fun buy_exact_sol_in for direct curve buys. This avoids 6002 exact-token slippage failures.
# CyA/FLASHX graduated buys need PumpSwap direct because Jupiter routes are often too large.
# The source router uses effectively no min-out; preflight catches broken direct txs before broadcast.
# Optional: maximum number of token positions open at the same time. Empty/commented = unlimited.
#MAX_SOL_PER_TOKEN=1

# Optional: skip pump.fun Mayhem Mode tokens before buying. Disabled unless set to true.

# Simulation / dry run
# 0 = estimate from current priority fee + sender/Jito tips. Set manually to force a flat fee.
# Deterministic paper failure model. Keep 0 while calibrating; raise to 1-3 for harsher paper tests.
# true = warn on RPC simulation lookup errors; false = mark the paper trade failed.



# Optional manual swap script

# Optional Telegram bot notifications


# Optional risk exits (percent vs remaining cost basis; empty/0 disables)
# ACTIVE: simple TP/SL only. No trailing. Operator-supervised � you watch the chart and
# decide manually when to exit pre-TP if a runner is going further. Auto-TP catches 2x.
# --- Alternate config: 2x with safety-net trail (revert by swapping comment markers) ---
# Same TP/SL but if peak reaches +50% and reverses, exit at +15% locked.
# TRAILING_STEPS=50:20,100:55,200:125,400:280

#
# --- Alternate config: aggressive trailing to catch source's 3x+ runners ---
# Data-driven: source's 21% of trades hit 3x+. No TP so trail catches huge winners.
#TRAILING_STEPS=20:-8,35:+5,60:+20,100:+50,200:+120,400:+280,800:+600
#MIN_HOLD_BEFORE_STOP_LOSS_MS=3500
#
# --- Jijo Settings ---
#STOP_LOSS_PCT=65
#TRAILING_STEPS=0:8,35:15,60:30,100:60,200:130,350:240,500:360,800:620,1200:950
# --- Earliest config (very tight, captures small wiggles only) ---
#TAKE_PROFIT_PCT=20
#TRAILING_STEPS=10:-8,13:3


