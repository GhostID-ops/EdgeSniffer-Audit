# FinalBot example environment
# Copy this file to .env, then fill in your own secrets.

# Required Helius/API keys
HELIUS_API_KEY=YOUR_HELIUS_API_KEY_HERE
SECURE_RPC_URL=https://YOUR_HELIUS_SECURE_RPC_URL_HERE
WEBSOCKET_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY_HERE

# Optional Shyft Yellowstone gRPC detection. Faster than WebSocket/REST fallback.
SHYFT_GRPC_ENABLED=false
SHYFT_GRPC_URL=https://grpc.ny.shyft.to
SHYFT_GRPC_X_TOKEN=YOUR_SHYFT_GRPC_X_TOKEN_HERE
SHYFT_RABBITSTREAM_ENABLED=false
SHYFT_RABBITSTREAM_URL=https://rabbitstream.ny.shyft.to/
SHYFT_GRPC_COMMITMENT=processed
SHYFT_GRPC_RECONNECT_MS=1000

# Optional Rust hot-path detector sidecar. Build first with: npm run rust-sidecar:build
RUST_SIDECAR_ENABLED=false
# Leave unset to use SHYFT_RABBITSTREAM_URL, or point at a specific Yellowstone/RabbitStream endpoint.
# RUST_SIDECAR_GRPC_URL=https://rabbitstream.ny.shyft.to/
# RUST_SIDECAR_BIN=rust-sidecar\target\release\pumpfun-sidecar.exe
# RUST_SIDECAR_USE_CARGO=false

# Required wallet key
# Never commit or share your real private key. Your friend should use his own wallet key unless you intentionally manage one shared wallet.
PRIVATE_KEY_BASE58=YOUR_PRIVATE_KEY_BASE58_HERE

# Source wallets to copy, comma-separated.
TRACKED_WALLETS=CyaE1VxvBrahnPWkqm5VsdCvyS2QmNht2UFrKJHga54o

# Licensing. Friends should fill LICENSE_KEY with the key you sell them.
LICENSE_KEY=FBOT-XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX
LICENSE_API_URL=https://your-license-api.example.com
LICENSE_CACHE_TTL_HOURS=24

# Quote asset for mirrored buys:
# SOL = always spend SOL, USDC = always spend USDC, MATCH = spend what the source wallet spent.
MIRROR_QUOTE_ASSET=SOL
MIN_BUY_USDC=50
MAX_BUY_USDC=60

# RPC, sender, and transaction landing
SENDER_ENDPOINT=http://ewr-sender.helius-rpc.com/fast
SENDER_RPC_FALLBACK_ENABLED=true
EXECUTION_MULTI_SEND_ENABLED=false
EXECUTION_RESCUE_RETRIES=2
EXECUTION_RESCUE_DELAY_MS=25
EXECUTION_ALT_ADDRESSES=
EXECUTION_TIP_MULTIPLIERS=pumpfun-direct-buy:1,pumpswap-direct-buy:1,pumpfun-direct-sell:1,pumpswap-direct-sell:1,jupiter-buy:1,jupiter-sell:1
EXECUTION_TELEMETRY_ENABLED=true
EXECUTION_TELEMETRY_PATH=data/execution-telemetry.jsonl
WARM_WALLET_MODE=true
KEEP_WSOL_ATA_OPEN=true
TIP_LAMPORTS=500000
PRIORITY_FEE_MICRO_LAMPORTS=200000
# Hard ceiling on the dynamic priority fee oracle (microLamports per CU). At ~95K CU per buy:
#    5,000,000 → 0.0005 SOL/tx   (0.05-0.19 SOL trade size)
#   50,000,000 → 0.005  SOL/tx   (0.5-1.0 SOL bets, recommended for sandwich strategies)
#  100,000,000 → 0.010  SOL/tx   (1+ SOL bets in tip-war territory)
DYNAMIC_PRIORITY_FEE_MAX_MICROLAMPORTS=10000000
# Real CU consumption per pump.fun buy is ~95K. Setting LIMIT close to actual usage helps
# inclusion priority — the leader deprioritizes txs that over-reserve CU. Don't go below ~120K.
COMPUTE_UNIT_LIMIT=1400000
FAST_MODE=true

# --- Jito direct bundle submission ---
# When enabled, broadcasts go straight to Jito's /api/v1/bundles instead of Helius Sender
# (which adds a Helius → Jito relay hop, ~50-100ms). Falls back to Helius Sender on Jito
# error if USE_JITO_FALLBACK=true. The tip transfer in your tx must hit one of Jito's 8
# current tip accounts (kept up-to-date in src/config.ts TIP_ACCOUNTS — refresh from
# https://ny.mainnet.block-engine.jito.wtf/api/v1/getTipAccounts if bundles get rejected).
USE_JITO_DIRECT=false
JITO_REGION=ny
JITO_REGIONS=ny,slc,dublin,london
JITO_AUTH_UUID=
USE_JITO_FALLBACK=true
BROADCAST_RACE_ENABLED=false

# --- Token-2022 direct sell (pump.fun sell_v2 path) ---
# When enabled, Token-2022 pump.fun sells use sell_v2 directly. Uses hardcoded fee + buyback
# recipient constants. If pump.fun rotates these, sells start failing — toggle off to fall
# back to Jupiter.
USE_PUMPFUN_TOKEN2022_DIRECT_SELL=true

# Entry filters and copytrade sizing
MAX_ENTRY_PRICE_IMPACT_PCT=25
MAX_IMPACT_REDUCE_ATTEMPTS=3
MAX_SOURCE_DRIFT_PCT=25
COPY_BUY_PERCENTAGE=100
MIN_BUY_SOL=1.5
MAX_BUY_SOL=1.75
SOL_RESERVE=0.5
MIRROR_SLIPPAGE_BPS=1200
MIRROR_RETRY_SLIPPAGE_BPS=2000
POLL_INTERVAL_MS=5000
MIRROR_SELLS=false
BUY_ONCE_PER_TOKEN=true
# If BUY_ONCE_PER_TOKEN=false, cap repeated entries/pyramids into the same mint.
# Empty/unset = no per-token buy-count cap.
MAX_BUYS_PER_TOKEN=
# Optional total SOL exposure cap per mint. Empty/unset = no per-token SOL cap.
MAX_SOL_PER_TOKEN=
MIRROR_GRADUATED_BUYS=false
PUMPFUN_EXACT_SOL_IN_BUYS=true
MAX_OPEN_POSITIONS=3
SHOW_MARKET_CAP=false

# --- Optional edge scout ---
# Separate process for PumpPortal new-token discovery. Disabled by default and never starts
# with the main copytrading bot.
EDGE_SCOUT_ENABLED=false
PUMPPORTAL_API_KEY=
EDGE_SCOUT_LOG_FILE=data/edge-scout.jsonl
EDGE_SCOUT_RECONNECT_MS=1500
# Leave false unless you intentionally want PumpPortal's metered account-trade stream.
EDGE_SCOUT_SUBSCRIBE_SOURCE_TRADES=false
EDGE_SCOUT_ACCOUNTS=

# Loss circuit breakers
DAILY_LOSS_LIMIT_SOL=10
CONSECUTIVE_LOSS_LIMIT=20
CIRCUIT_BREAKER_PAUSE_MS=600000

# Current scalp/risk profile
STOP_LOSS_PCT=14
TAKE_PROFIT_PCT=15
TRAILING_STEPS=10:-8,13:3
MIN_HOLD_BEFORE_STOP_LOSS_MS=3000

# Risk quote cadence
RISK_FAST_INTERVAL_MS=400
RISK_FAST_WINDOW_MS=20000
RISK_NEAR_TRIGGER_INTERVAL_MS=400
RISK_NORMAL_INTERVAL_MS=1000
RISK_NEAR_TRIGGER_PCT=8
RISK_DRIFT_PCT_PER_SEC=5
MAX_RISK_QUOTES_PER_CHECK=3

# Jupiter and Helius rate-limit protection
JUPITER_QUOTE_MIN_GAP_MS=500
JUPITER_QUOTE_429_COOLDOWN_MS=3000
JUPITER_QUOTE_RETRIES=1
JUPITER_OVERSIZE_MAX_ACCOUNTS=40,32,24,16
HELIUS_MIN_REQUEST_GAP_MS=100
HELIUS_429_COOLDOWN_MS=10000
JUPITER_MAX_ACCOUNTS=48
JUPITER_ONLY_DIRECT_ROUTES=false

# Simulation / dry run
SIMULATION_MODE=true
DRY_RUN=false
SIMULATION_SOL_BALANCE=10
STARTING_SOL_BALANCE=5

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BROADCAST_CHAT_ID=
