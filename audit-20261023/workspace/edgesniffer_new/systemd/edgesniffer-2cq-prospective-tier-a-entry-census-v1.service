[Unit]
Description=EdgeSniffer 2CQ prospective Tier-A entry census V1 (outcome-blind, no-submit)
After=pump-exact-evidence-ledger-v1.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer
RuntimeDirectory=edgesniffer-2cq-tier-a-census-v1
ExecStart=/usr/bin/flock -n /run/edgesniffer-2cq-tier-a-census-v1/run.lock /usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqProspectiveTierAEntryCensusV1.py --detector /var/lib/edgesniffer-teacher-impulse-parity-v1/detected-swaps.jsonl --exact-root /var/lib/pump-exact-evidence-ledger-v1 --output /var/lib/pump-exact-evidence-ledger-v1/2cq-prospective-tier-a-entry-census-v1 --historical-script /root/bot/EdgeSniffer/scripts/twoCqCausalEntryTimingFingerprintV1.py --historical-report /mnt/HC_Volume_106775198/edgesniffer-research/2cq-teacher-validation/2CQ_CAUSAL_ENTRY_TIMING_FINGERPRINT_V1/report.json
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/pump-exact-evidence-ledger-v1
PrivateTmp=true
