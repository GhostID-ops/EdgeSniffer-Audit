ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/refresh2CQFingerprintMarketWindowsV1.py --input /mnt/HC_Volume_106775198/edgesniffer-research/independent-strategy-lab-v1/native-boundary-replay-v1.jsonl --fingerprint /mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v1/2cq-fingerprint-independent-v1.json --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-independent-fingerprint-v1/prospective-market-windows-20261022T164227Z.jsonl --start-at-receive-ms 1792687347000 --poll-sec 60
