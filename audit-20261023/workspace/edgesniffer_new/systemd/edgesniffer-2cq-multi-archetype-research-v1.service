[Unit]
Description=EdgeSniffer 2CQ multi-archetype research V1 (outcome-blind/no-submit)
After=network-online.target edgesniffer-2cq-symmetric-choice-materializer-v2.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer
ExecStart=/usr/bin/flock -n /run/edgesniffer-2cq-multi-archetype-v1.lock /usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqMultiArchetypeResearchV1.py --v2-state /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v2/causal-state-v2.sqlite3 --v2-contract /root/bot/EdgeSniffer/research/2cq-prospective-symmetric-choice-census-v2/contract.json --state-plane /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v2/causal-state-plane-v1.sqlite3 --candidates /mnt/HC_Volume_106775198/edgesniffer-research/2cq-capture-first-detector-repair-v1/prospective/candidates.jsonl --compact-arrivals /mnt/HC_Volume_106775198/edgesniffer-research/2cq-realtime-delivery-path-localization-v1/allenhark-signature-arrivals-v1.bin --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-multi-archetype-research-v1
ExecStartPost=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqRouteProtocolInventoryV1.py --v2-state /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v2/causal-state-v2.sqlite3 --wallet-rpc-cache /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v2/wallet-rpc-cache --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-multi-archetype-research-v1
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
TimeoutStartSec=15min
MemoryHigh=3G
MemoryMax=4G

