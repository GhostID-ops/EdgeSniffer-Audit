[Unit]
Description=EdgeSniffer Model A 1s top-tail prospective v2 no-submit shadow
After=network-online.target edgesniffer-teacher-impulse-parity-v1-capsule-normalizer.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/bot/FinalBot-cya
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /mnt/HC_Volume_106775198/modelAProspectiveShadowV1.py --input /var/lib/edgesniffer-teacher-impulse-parity-v1/candidate-capsules.jsonl --historical-enriched /mnt/HC_Volume_106775198/edgesniffer-derived/executable-alpha-enrichment-v1/enriched_1s_2s_snapshots.jsonl.gz --out-dir /mnt/HC_Volume_106775198/edgesniffer-derived/model-a-1s-prospective-v2-20260902T221900Z --poll-ms 10 --start-at-end
Restart=always
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
