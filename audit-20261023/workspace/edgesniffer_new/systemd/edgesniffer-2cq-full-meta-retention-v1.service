[Unit]
Description=EdgeSniffer 2CQ full-meta conservative retention audit
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqFullMetaRetentionV1.py --root /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1 --work-db /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/automation/n-worker.sqlite3 --retain-hours 12 --apply --report /mnt/HC_Volume_106775198/edgesniffer-research/2cq-yellowstone-full-meta-prospective-v1/retention/latest.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
