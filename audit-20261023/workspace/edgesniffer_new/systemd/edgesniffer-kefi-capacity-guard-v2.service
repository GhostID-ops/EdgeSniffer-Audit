[Unit]
Description=EdgeSniffer kEFi fresh replication capacity guard

[Service]
Type=oneshot
ExecStartPre=/usr/bin/mkdir -p /mnt/edgesniffer-kefi-hot/kefi-capture-first-live-v6
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/kefi_full_meta_capacity_guard_v1.py --hot-root /mnt/edgesniffer-kefi-hot/kefi-capture-first-live-v6 --host-mount / --state /mnt/edgesniffer-kefi-hot/kefi-capture-first-live-v6/operations/capacity-guard.json --collector-unit edgesniffer-kefi-full-meta-capture-first-v6.service --systemd-scope system --warning-free-gib 40 --emergency-free-gib 25
