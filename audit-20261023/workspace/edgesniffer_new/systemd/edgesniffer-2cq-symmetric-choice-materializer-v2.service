[Unit]
Description=EdgeSniffer 2CQ prospective symmetric choice materializer V2 (outcome-blind/no-submit)
After=network-online.target edgesniffer-2cq-capture-first-v1.service pump-exact-evidence-ledger-v1.service
Wants=network-online.target
OnSuccess=edgesniffer-2cq-extended-route-materializer-v1.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer/scripts
ExecStart=/usr/bin/flock -n /run/edgesniffer-2cq-symmetric-choice-v2.lock /usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqProspectiveSymmetricChoiceMaterializerV2.py --contract /root/bot/EdgeSniffer/research/2cq-prospective-symmetric-choice-census-v2/contract.json --invalid-intervals /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v1/invalid-collection-intervals.jsonl --candidates /mnt/HC_Volume_106775198/edgesniffer-research/2cq-capture-first-detector-repair-v1/prospective/candidates.jsonl --compact-arrivals /mnt/HC_Volume_106775198/edgesniffer-research/2cq-realtime-delivery-path-localization-v1/allenhark-signature-arrivals-v1.bin --compact-observer-health /mnt/HC_Volume_106775198/edgesniffer-research/2cq-realtime-delivery-path-localization-v1/observer-health.json --compact-observer-continuity /mnt/HC_Volume_106775198/edgesniffer-research/2cq-realtime-delivery-path-localization-v1/observer-continuity.jsonl --exact-root /var/lib/pump-exact-evidence-ledger-v1 --env /root/bot/EdgeSniffer/.env --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v2
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
TimeoutStartSec=infinity
MemoryHigh=5G
MemoryMax=6G
