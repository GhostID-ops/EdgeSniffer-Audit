[Unit]
Description=EdgeSniffer 2CQ Yellowstone route-init arrival observer V1 (future-only, outcome-blind)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/EdgeSniffer
EnvironmentFile=/root/bot/EdgeSniffer/.env
Environment=ROUTE_INIT_ARRIVAL_ROOT=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-route-init-registry-v1/arrival-candidates-compact
Environment=YELLOWSTONE_ROUTE_INIT_ARRIVAL_HEALTH=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-route-init-registry-v1/yellowstone-observer-health.json
ExecStart=/usr/local/bin/edgesniffer-2cq-yellowstone-route-init-arrival-observer-v1
Restart=always
RestartSec=1s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-route-init-registry-v1

[Install]
WantedBy=multi-user.target
