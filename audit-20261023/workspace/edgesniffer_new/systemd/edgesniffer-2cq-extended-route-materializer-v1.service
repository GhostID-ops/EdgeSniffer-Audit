[Unit]
Description=EdgeSniffer 2CQ extended route evidence materializer V1 (research only)
After=edgesniffer-2cq-symmetric-choice-materializer-v3.service
OnSuccess=edgesniffer-2cq-route-symmetric-choice-v1.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer/scripts
RuntimeDirectory=edgesniffer-2cq-extended-route-v1
ExecStart=/usr/bin/flock -n /run/edgesniffer-2cq-extended-route-v1/materialize.lock /usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqExtendedRouteMaterializerV1.py --source-state /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v3/causal-state-v2.sqlite3 --wallet-rpc-cache /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v3/wallet-rpc-cache --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-extended-route-evidence-v1
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-extended-route-evidence-v1 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v2 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v3
TimeoutStartSec=10min
MemoryHigh=1G
MemoryMax=2G
