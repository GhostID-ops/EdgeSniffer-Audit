[Unit]
Description=EdgeSniffer route-specific 2CQ symmetric choice cohorts V1 (outcome-blind/no-submit)
After=edgesniffer-2cq-extended-route-materializer-v1.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer/scripts
RuntimeDirectory=edgesniffer-2cq-route-symmetric-v1
ExecStart=/usr/bin/flock -n /run/edgesniffer-2cq-route-symmetric-v1/materialize.lock /usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqRouteSpecificSymmetricChoiceV1.py --source-state /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v3/causal-state-v2.sqlite3 --route-state /mnt/HC_Volume_106775198/edgesniffer-research/2cq-extended-route-evidence-v1/state.sqlite3 --quote-state /mnt/HC_Volume_106775198/edgesniffer-research/pump-quote-native-state-v1/quote-native-state-v1.sqlite3 --pumpswap-state /mnt/HC_Volume_106775198/edgesniffer-research/pumpswap-choice-window-v1/pumpswap-choice-window-state-v1.sqlite3 --launchlab-state /mnt/HC_Volume_106775198/edgesniffer-research/2cq-launchlab-coverage-v1/launchlab-state-v1.sqlite3 --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-route-symmetric-choice-v1
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-route-symmetric-choice-v1 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v2 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v3 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-extended-route-evidence-v1 /mnt/HC_Volume_106775198/edgesniffer-research/pump-quote-native-state-v1 /mnt/HC_Volume_106775198/edgesniffer-research/pumpswap-choice-window-v1 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-launchlab-coverage-v1
TimeoutStartSec=15min
MemoryHigh=3G
MemoryMax=5G
CPUWeight=5
IOWeight=5
