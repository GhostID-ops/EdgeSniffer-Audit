[Unit]
Description=Validate cached 2CQ LaunchLab exact transitions V1 (outcome blind)
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer/scripts
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/twoCqLaunchLabCoverageV1.py --route-inventory /mnt/HC_Volume_106775198/edgesniffer-research/2cq-multi-archetype-research-v1/route-protocol-inventory.jsonl --wallet-rpc-cache /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v2/wallet-rpc-cache --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-launchlab-coverage-v1
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-launchlab-coverage-v1
TimeoutStartSec=15min
MemoryHigh=2G
MemoryMax=3G
