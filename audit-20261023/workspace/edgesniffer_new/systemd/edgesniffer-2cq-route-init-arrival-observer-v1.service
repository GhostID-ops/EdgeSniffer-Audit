[Unit]
Description=EdgeSniffer 2CQ route-init arrival observer V1 (future-only, outcome-blind)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/EdgeSniffer
Environment=ALLENHARK_SHREDSTREAM_GRPC_URL=http://127.0.0.1:9999
Environment=ROUTE_INIT_ARRIVAL_ROOT=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-route-init-registry-v1/arrival-candidates-compact
Environment=ROUTE_INIT_ARRIVAL_HEALTH=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-route-init-registry-v1/observer-health.json
Environment=ROUTE_INIT_RECONNECT_MS=500
ExecStart=/usr/local/bin/edgesniffer-2cq-route-init-arrival-observer-v1
Restart=always
RestartSec=500ms
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-route-init-registry-v1

[Install]
WantedBy=multi-user.target
