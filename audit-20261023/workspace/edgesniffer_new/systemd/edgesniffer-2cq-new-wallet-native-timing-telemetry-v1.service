[Unit]
Description=EdgeSniffer 2CQ new-wallet native timing telemetry gate (receive-only)
After=network-online.target edgesniffer-2cq-new-wallet-route-source-v1.service edgesniffer-2cq-new-wallet-pump-curve-prospective-v1.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/EdgeSniffer
EnvironmentFile=/root/bot/EdgeSniffer/.env
ExecStart=/usr/bin/python3 /root/bot/EdgeSniffer/scripts/auditNativeTimingTelemetryGateV1.py --source /mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v1/raw-transactions.jsonl --windows /mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v8/pump-curve-prospective-windows-v1.jsonl --native-receipts /mnt/HC_Volume_106775198/edgesniffer-research/allenhark-realtime-coverage-final-repair-v1/live-shadow-v1/target-receipts.jsonl --exit-telemetry /mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v9/submitted-exit-telemetry.jsonl --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v9/native-timing-telemetry-gate-v1.json --interval-seconds 300
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-new-wallet-route-census-v9

[Install]
WantedBy=multi-user.target
