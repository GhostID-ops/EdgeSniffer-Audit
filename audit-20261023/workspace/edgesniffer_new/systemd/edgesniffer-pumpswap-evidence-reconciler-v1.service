[Unit]
Description=EdgeSniffer PumpSwap finalized evidence reconciler V1 (research only)
After=network-online.target edgesniffer-allenhark-compact-delivery-observer-v1.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/bot/EdgeSniffer/scripts
RuntimeDirectory=edgesniffer-pumpswap-v1
ExecStart=/usr/bin/flock -n /run/edgesniffer-pumpswap-v1/reconcile.lock /usr/bin/python3 /root/bot/EdgeSniffer/scripts/pumpSwapEvidenceReconcilerV1.py --compact-arrivals /mnt/HC_Volume_106775198/edgesniffer-research/2cq-realtime-delivery-path-localization-v1/allenhark-signature-arrivals-v1.bin --compact-index-state /mnt/HC_Volume_106775198/edgesniffer-research/2cq-launchlab-coverage-v1/launchlab-state-v1.sqlite3 --env /root/bot/EdgeSniffer/.env --output /mnt/HC_Volume_106775198/edgesniffer-research/2cq-pumpswap-evidence-v1 --teacher-state /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v2/causal-state-v2.sqlite3 --limit 250 --max-signatures-per-pool 250
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/root/bot/EdgeSniffer/.env
ReadWritePaths=/mnt/HC_Volume_106775198/edgesniffer-research/2cq-pumpswap-evidence-v1 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-prospective-symmetric-choice-census-v2 /mnt/HC_Volume_106775198/edgesniffer-research/2cq-launchlab-coverage-v1
TimeoutStartSec=15min
MemoryHigh=2G
MemoryMax=3G
CPUWeight=5
IOWeight=5
