{
  "name": "finalbot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/copytrade.ts",
    "prebot": "tsx src/killOldProcesses.ts bot",
    "bot": "tsx src/copytrade.ts",
    "dev": "tsx src/copytrade.ts",
    "web": "tsx src/web.ts",
    "vps:control": "tsx src/vpsControlPanel.ts",
    "swap": "tsx src/swap.ts",
    "profile-edge": "tsx src/profileSourceEdge.ts",
    "find-source-wallet": "tsx src/findSourceWallet.ts",
    "edge-scout": "tsx src/edgeScout.ts",
    "license-api": "tsx src/licenseApi.ts",
    "license:create": "tsx src/licenseAdmin.ts create",
    "license:revoke": "tsx src/licenseAdmin.ts revoke",
    "license:reset-machine": "tsx src/licenseAdmin.ts reset-machine",
    "license:list": "tsx src/licenseAdmin.ts list",
    "env:performance": "node scripts/applyPerformanceEnv.mjs",
    "env:free-helius": "node scripts/applyPerformanceEnv.mjs .env.performance.free-helius",
    "env:infra-engine": "node scripts/applyPerformanceEnv.mjs .env.infra-engine",
    "env:friend-latest": "node scripts/applyPerformanceEnv.mjs .env.friend-latest",
    "env:friend-exposure": "node scripts/applyPerformanceEnv.mjs .env.friend-exposure",
    "env:friend-recommended": "node scripts/applyPerformanceEnv.mjs .env.friend-recommended",
    "env:copy-percentage": "node scripts/applyPerformanceEnv.mjs .env.copy-percentage",
    "env:vps-tiny-live-test": "node scripts/applyPerformanceEnv.mjs .env.vps-tiny-live-test",
    "env:speed-mode": "node scripts/applyPerformanceEnv.mjs .env.speed-mode",
    "env:cya-same-slot": "node scripts/applyPerformanceEnv.mjs .env.cya-same-slot",
    "env:4bdk-same-slot": "node scripts/applyPerformanceEnv.mjs .env.4bdk-same-slot",
    "friend:update": "powershell -ExecutionPolicy Bypass -File scripts/updateFriendBot.ps1",
    "friend:update:exposure": "powershell -ExecutionPolicy Bypass -File scripts/updateFriendBot.ps1 -ApplyExposure",
    "friend:update:recommended": "powershell -ExecutionPolicy Bypass -File scripts/updateFriendBot.ps1 -ApplyRecommended",
    "telemetry:execution": "tsx src/executionTelemetryReport.ts",
    "telemetry:scan-today": "node scripts/scanTodayTelemetry.mjs",
    "audit:source-coverage": "node scripts/auditSourceCoverage.mjs",
    "audit:omego-weekly": "bash scripts/runOmegoWeeklyAuditSlow.sh",
    "sim:omego-env": "node scripts/simulateOmegoEnvStrategies.mjs",
    "test:license": "tsx src/testLicense.ts",
    "rust-sidecar": "cargo run --manifest-path rust-sidecar/Cargo.toml --release",
    "rust-sidecar:build": "cargo build --manifest-path rust-sidecar/Cargo.toml --release",
    "rust-sidecar:jito-build": "cargo build --manifest-path rust-sidecar/Cargo.toml --release --features jito-shredstream",
    "test:pumpswap": "tsx src/testPumpSwap.ts",
    "test:buy-once": "node dist/testBuyOncePolicy.js",
    "test:source-positions": "tsx src/testSourcePositions.ts",
    "test:idl": "tsx src/testIdlBuilders.ts",
    "test:retry": "tsx src/testExecutionRetry.ts",
    "test:post-sell-lifecycle": "tsx src/testPostSellLifecycle.ts",
    "test:confirmed-inventory": "tsx src/testConfirmedInventory.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "@triton-one/yellowstone-grpc": "^4.0.2",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
