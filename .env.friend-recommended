# Friend recommended non-secret strategy/runtime preset.
# Applies your current bot behavior to a friend's .env while preserving his secrets.
# Safe to apply with:
#   npm run env:friend-recommended
#
# This intentionally does NOT set:
# PRIVATE_KEY_BASE58, LICENSE_KEY, RPC URLs/API keys, Shyft tokens, Telegram secrets,
# TRACKED_WALLETS, Helius/Moralis/Supabase keys, or admin tokens.
#
# Active exposure key mapping:
#   MAX_SOL_PER_TOKEN is the active replacement for old MAX_TOKEN_EXPOSURE_SOL.
#   COPY_BUY_PERCENTAGE is the active replacement for old MIRROR_BUY_SCALE-style scaling.

# Live execution
SIMULATION_MODE=false
DRY_RUN=false
SHADOW_EXECUTION_MODE=false

# Copy sizing and exposure
MIN_BUY_BEHAVIOR=floor
MIN_BUY_SOL=0.25
MAX_BUY_SOL=0.3
COPY_BUY_PERCENTAGE=100
MIRROR_QUOTE_ASSET=MATCH
SOL_RESERVE=0.01
MAX_OPEN_POSITIONS=3
BUY_ONCE_PER_TOKEN=true
MAX_BUYS_PER_TOKEN=1
MAX_SOL_PER_TOKEN=0.16
MAX_SESSION_DEPLOYED_SOL=0.75

# Entry/routing behavior
MIRROR_SELLS=false
MIRROR_GRADUATED_BUYS=true
PUMPFUN_EXACT_SOL_IN_BUYS=true
PUMPSWAP_DIRECT_BUY_ENABLED=true
PUMPSWAP_DIRECT_MIN_OUT_BPS=0
PUMPSWAP_DIRECT_PREFLIGHT=true
MAX_ENTRY_PRICE_IMPACT_PCT=60
MIRROR_SLIPPAGE_BPS=6000
MIRROR_RETRY_SLIPPAGE_BPS=10000

# Source preexisting guard
SKIP_SOURCE_PREEXISTING_MINTS=true
SOURCE_PREEXISTING_SCAN_TX_LIMIT=0

# Risk exits
STOP_LOSS_PCT=45
TAKE_PROFIT_PCT=
TRAILING_STEPS=60:15,100:40,160:85,250:150,400:260,700:500
MIN_HOLD_BEFORE_STOP_LOSS_MS=25000
RISK_FAST_INTERVAL_MS=400
RISK_FAST_WINDOW_MS=20000
RISK_NEAR_TRIGGER_INTERVAL_MS=400
RISK_NORMAL_INTERVAL_MS=1000
RISK_NEAR_TRIGGER_PCT=8
RISK_DRIFT_PCT_PER_SEC=5
MAX_RISK_QUOTES_PER_CHECK=3
